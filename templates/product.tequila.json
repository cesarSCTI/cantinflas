      "blocks": {
        "piece1": {
          "type": "detail",
          "settings": {
            "heading": "1- Cocción (50/50)",
            "text": "<p>50% en hornos de mampostería (~48 h): cocción lenta que desarrolla notas profundas de agave cocido.</p><p>50% en autoclave (~16 h): cocción controlada para consistencia y precisión en el punto de cocción.</p>"
          }
        },
        "piece2": {
          "type": "detail",
          "settings": {
            "heading": "2- Molienda / Extracción",
            "text": "<p>La fibra cocida se prensa en molinos tradicionales, extrayendo mieles ricas en azúcares que darán origen a mostos limpios y balanceados</p>"
          }
        }
      },
