{{ 'cantinflas-tequila.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cantinflas-tequila.js' | asset_url }}" defer></script>

<cantinflas-tequila-cocktails class="ct-tequila ct-cocktails" style="
      --ct-bg: {{ section.settings.background }};
      --ct-card-title: {{ section.settings.card_title_color }};
      --ct-card-size: {{ section.settings.card_title_size }}px;
      --ct-card-radius: {{ section.settings.radius }}px;
      --ct-plus-bg: {{ section.settings.plus_background }};
      --ct-plus-color: {{ section.settings.plus_color }};
      --ct-heading-color: {{ section.settings.heading_color }};
      --ct-heading-align: {{ section.settings.heading_align }};
      --ct-heading-max: {{ section.settings.heading_size }}px;
      --ct-heading-mobile: {{ section.settings.heading_mobile }}px;
      --ct-body-color: {{ section.settings.body_color }};
      --ct-body-align: {{ section.settings.body_align }};
      --ct-body-size: {{ section.settings.body_size }}px;
      --ct-pad-top: {{ section.settings.padding_top }}px;
      --ct-pad-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="ct-tequila__rail">
    {% if section.settings.heading != blank %}
      <h2 class="ct-tequila__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="ct-tequila__copy rte">{{ section.settings.body }}</div>
    {% endif %}
    <div class="ct-cocktails__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign fallback = block.settings.reference | replace: 'none', ''
          assign back_id = 'TequilaCocktail-' | append: section.id | append: '-' | append: block.id
          assign card_name = block.settings.title | default: 'Cóctel'
          assign has_link = false
          if block.settings.link != blank and block.settings.link_label != blank
            assign has_link = true
          endif
        -%}
        <article class="ct-cocktails__card" {{ block.shopify_attributes }} style="
          --ct-back-bg: {{ block.settings.back_background | default: '#252525' }};
          --ct-back-text: {{ block.settings.back_text_color | default: '#ffffff' }};
          --ct-back-fit: {{ block.settings.back_image_fit | default: 'contain' }};
        ">
          <div class="ct-cocktails__media">
            <button class="ct-cocktails__plus" type="button" aria-expanded="false" aria-controls="{{ back_id }}" hidden>
              <span class="ct-cocktails__open-icon" aria-hidden="true">+</span>
              <span class="ct-cocktails__close-icon" aria-hidden="true">−</span>
              <span class="visually-hidden ct-cocktails__open-icon">{{ section.settings.open_label | default: 'Ver' | escape }} {{ card_name | escape }}</span>
              <span class="visually-hidden ct-cocktails__close-icon">{{ section.settings.close_label | default: 'Cerrar' | escape }} {{ card_name | escape }}</span>
            </button>
            <div class="ct-cocktails__faces">
              <div class="ct-cocktails__front" style="--ct-object-position: {{ block.settings.image_x }}% {{ block.settings.image_y }}%;">
                {% render 'cantinflas-tequila-image', image: block.settings.image, fallback: fallback, alt: card_name, sizes: '(min-width: 750px) 28vw, 90vw' %}
              </div>
              <div class="ct-cocktails__back" id="{{ back_id }}"{% if block.settings.back_image == blank and block.settings.details == blank and has_link == false %} data-empty{% endif %}>
                {% if block.settings.back_image != blank %}
                  {% render 'cantinflas-tequila-image', image: block.settings.back_image, sizes: '(min-width: 750px) 28vw, 90vw' %}
                {% endif %}
                {% if block.settings.details != blank or has_link %}
                  <div class="ct-cocktails__details rte" tabindex="0" role="group" aria-label="Información de {{ card_name | escape }}">
                    {{ block.settings.details }}
                    {% if has_link %}
                      <a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
                    {% endif %}
                  </div>
                {% elsif block.settings.back_image == blank %}
                  <p class="ct-cocktails__back-name">{{ card_name | escape }}</p>
                {% endif %}
              </div>
            </div>
          </div>
          {% if block.settings.title != blank %}
            <h3 style="--ct-note-color: {{ block.settings.title_color | default: section.settings.card_title_color }}">{{ block.settings.title | escape }}</h3>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</cantinflas-tequila-cocktails>

{% schema %}
{
  "name": "Cocteles Tequila",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título",
      "default": "A tu manera, para cada ocasión"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título en escritorio",
      "min": 28,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Tamaño del título en móvil",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color del texto",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "body_align",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Tamaño del texto",
      "min": 12,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo de la sección",
      "default": "#36845d"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Color de los nombres",
      "default": "#f2b846"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Tamaño de los nombres",
      "min": 14,
      "max": 42,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Redondeo de la foto",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "plus_background",
      "label": "Fondo del botón +",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "plus_color",
      "label": "Color del símbolo +",
      "default": "#180c09"
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "Etiqueta para abrir",
      "default": "Ver"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Etiqueta para cerrar",
      "default": "Cerrar"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 90
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "cocktail",
      "name": "Coctel",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen frontal"
        },
        {
          "type": "select",
          "id": "reference",
          "label": "Imagen de Adobe XD",
          "options": [
            {
              "value": "none",
              "label": "Ninguna"
            },
            {
              "value": "margarita",
              "label": "Margarita"
            },
            {
              "value": "paloma",
              "label": "Paloma"
            },
            {
              "value": "diablo",
              "label": "Mexican El Diablo"
            }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "image_x",
          "label": "Posición horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "image_y",
          "label": "Posición vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Color del nombre"
        },
        {
          "type": "header",
          "content": "Reverso de la tarjeta"
        },
        {
          "type": "image_picker",
          "id": "back_image",
          "label": "Imagen del reverso"
        },
        {
          "type": "select",
          "id": "back_image_fit",
          "label": "Ajuste de la imagen del reverso",
          "options": [
            { "value": "contain", "label": "Mostrar completa" },
            { "value": "cover", "label": "Rellenar la tarjeta" }
          ],
          "default": "contain"
        },
        {
          "type": "color",
          "id": "back_background",
          "label": "Fondo del reverso",
          "default": "#252525"
        },
        {
          "type": "color",
          "id": "back_text_color",
          "label": "Color del texto del reverso",
          "default": "#ffffff"
        },
        {
          "type": "richtext",
          "id": "details",
          "label": "Información del reverso"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace del detalle"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cocteles Tequila",
      "blocks": [
        {
          "type": "cocktail",
          "settings": {
            "title": "MARGARITA",
            "reference": "margarita"
          }
        },
        {
          "type": "cocktail",
          "settings": {
            "title": "PALOMA",
            "reference": "paloma"
          }
        },
        {
          "type": "cocktail",
          "settings": {
            "title": "MEXICAN EL DIABLO",
            "reference": "diablo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
