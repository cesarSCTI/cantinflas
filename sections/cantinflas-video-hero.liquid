{{ 'section-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'video-controls.js' | asset_url }}" defer></script>

<section class="cantinflas-video-hero cantinflas-video-hero--{{ section.settings.alignment }}"
  style="--cvh-bg: {{ section.settings.background_gradient | default: section.settings.background }}; --cvh-fg: {{ section.settings.text_color }}; --cvh-title: {{ section.settings.heading_color | default: section.settings.text_color }};
  --cvh-subtitle: {{ section.settings.subheading_color | default: section.settings.text_color }};
  --cvh-title-align: {{ section.settings.heading_align }}; --cvh-subtitle-align: {{ section.settings.subheading_align }};
  --cvh-title-size: {{ section.settings.heading_size }}px; --cvh-title-mobile: {{ section.settings.heading_mobile }}px;
  {% if section.settings.alignment == 'contact' %}
    --cvh-title-fluid: {{ section.settings.heading_size | divided_by: 19.2 }}vw;
    --cvh-title-mobile-fluid: {{ section.settings.heading_mobile | divided_by: 5.5 }}vw;
  {% endif %}
  --cvh-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <cantinflas-hero-media class="cantinflas-video-hero__media" data-autoplay="{{ section.settings.autoplay }}">
    {% liquid
      assign desktop_video = section.settings.video
      assign mobile_video = section.settings.mobile_video
      assign active_video = desktop_video | default: mobile_video
      assign native_autoplay = section.settings.autoplay
      if desktop_video != blank and mobile_video != blank
        assign native_autoplay = false
        assign desktop_class = 'wt-mobile-hidden'
      endif
    %}
    {% if active_video %}
      <video-controls class="{{ desktop_class }}" data-video-click="false">
        {% render 'play-pause-button' %}
        {{ active_video | video_tag: autoplay: native_autoplay, loop: true, muted: true, playsinline: true, controls: false, image_size: '1600x' }}
      </video-controls>
      {% if desktop_video != blank and mobile_video != blank %}
        <video-controls class="wt-desktop-hidden" data-video-click="false">
          {% render 'play-pause-button' %}
          {{ mobile_video | video_tag: autoplay: native_autoplay, loop: true, muted: true, playsinline: true, controls: false, image_size: '800x' }}
        </video-controls>
      {% endif %}
    {% elsif section.settings.cover != blank %}
      {{ section.settings.cover | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 750, 1080, 1600, 1920, 2400', sizes: '100vw' }}
    {% elsif section.settings.cover_asset != blank %}
      <img src="{{ section.settings.cover_asset | asset_url }}" alt="" width="{{ section.settings.cover_width }}" height="{{ section.settings.cover_height }}" fetchpriority="high">
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'cantinflas-video-hero__placeholder' }}
    {% endif %}
  </cantinflas-hero-media>
  <div class="cantinflas-video-hero__copy">
    {% if section.settings.title_image != blank %}
      <h1>{{ section.settings.title_image | image_url: width: 960 | image_tag: loading: 'eager', widths: '320, 480, 640, 960', alt: section.settings.heading }}</h1>
    {% else %}
      <h1>{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}
  </div>
</section>

{% stylesheet %}
  .cantinflas-video-hero { position: relative; isolation: isolate; display: grid; align-items: end; min-height: clamp(36rem, 52vw, 102rem); color: var(--cvh-fg); background: var(--cvh-bg); }
  .cantinflas-video-hero--center { place-items: center; text-align: center; }
  .cantinflas-video-hero__media, .cantinflas-video-hero__media video-controls { position: absolute; inset: 0; }
  .cantinflas-video-hero__media > img, .cantinflas-video-hero__media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cantinflas-video-hero__media::after { position: absolute; inset: 0; pointer-events: none; background: rgb(0 0 0 / var(--cvh-overlay)); content: ''; }
  .cantinflas-video-hero--center .cantinflas-video-hero__media > img { object-fit: contain; object-position: center bottom; }
  .cantinflas-video-hero__copy { position: relative; pointer-events: none; width: min(86%, 1640px); margin: 0 auto; padding: clamp(3rem, 6vw, 10rem) 0; }
  .cantinflas-video-hero__copy h1 { color: inherit; margin: 0; font-size: clamp(4rem, 8vw, 13rem); line-height: 1; }
  .cantinflas-video-hero__copy h1 img { width: min(68vw, 64rem); height: auto; }
  .cantinflas-video-hero__copy p { margin: 1rem 0 0; font-size: clamp(1.5rem, 1.8vw, 3rem); }
  .cantinflas-video-hero__media .shoppable-video__control-button { position: absolute; z-index: 1; right: 2rem; bottom: 2rem; }

  .cantinflas-video-hero__media > svg { display: block; width: 100%; height: 100%; object-fit: cover; background: #e6e1db; }
  .cantinflas-video-hero .cantinflas-video-hero__copy h1 { color: var(--cvh-title); text-align: var(--cvh-title-align); font-size: var(--cvh-title-mobile); }
  .cantinflas-video-hero__copy p { color: var(--cvh-subtitle); text-align: var(--cvh-subtitle-align); }
  @media (min-width: 900px) {
    .cantinflas-video-hero .cantinflas-video-hero__copy h1 { font-size: var(--cvh-title-size); }
  }

  .cantinflas-video-hero.cantinflas-video-hero--contact {
    align-items: center;
    min-height: clamp(220px, 48vw, 410px);
    z-index: 1;
  }

  .cantinflas-video-hero--contact .cantinflas-video-hero__media {
    inset: 22% auto -20% 5%;
    width: 43%;
  }

  .cantinflas-video-hero--contact .cantinflas-video-hero__media > img {
    object-fit: contain;
    object-position: center bottom;
  }

  .cantinflas-video-hero--contact .cantinflas-video-hero__copy {
    width: 49%;
    margin: 0 0 0 47%;
    padding-block: 3rem 0;
  }

  .cantinflas-video-hero.cantinflas-video-hero--contact .cantinflas-video-hero__copy h1 {
    font-size: min(var(--cvh-title-mobile), var(--cvh-title-mobile-fluid));
    line-height: 1.08;
    white-space: pre-line;
    overflow-wrap: normal;
    word-break: normal;
  }

  .cantinflas-video-hero--contact .cantinflas-video-hero__copy h1 img { width: auto; max-width: 100%; }

  @media (min-width: 750px) {
    .cantinflas-video-hero.cantinflas-video-hero--contact {
      min-height: clamp(265px, 36.98vw, 710px);
    }

    .cantinflas-video-hero--contact .cantinflas-video-hero__media {
      inset: min(6.1vw, 117px) auto max(-9vw, -173px) max(9.95%, calc((100% - 1920px) / 2 + 191px));
      width: min(32.6%, 626px);
    }

    .cantinflas-video-hero--contact .cantinflas-video-hero__copy {
      width: min(51%, 979px);
      margin-left: max(39.8%, calc((100% - 1920px) / 2 + 764px));
      padding: clamp(1rem, 4.2vw, 8.1rem) 0 0;
    }

    .cantinflas-video-hero.cantinflas-video-hero--contact .cantinflas-video-hero__copy h1 {
      font-size: min(var(--cvh-title-size), var(--cvh-title-fluid));
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cantinflas-hero-media')) {
    customElements.define('cantinflas-hero-media', class extends HTMLElement {
      connectedCallback() {
        const videos = this.querySelectorAll('video');
        if (videos.length !== 2) return;

        this.desktop = matchMedia('(min-width: 1200px)');
        this.syncVideos = () => {
          const active = this.desktop.matches ? 0 : 1;
          videos[1 - active].pause();
          if (this.dataset.autoplay === 'true') {
            videos[active].play().catch(() => {
              // The theme's play button remains available if autoplay is blocked.
            });
          }
        };
        this.desktop.addEventListener('change', this.syncVideos);
        this.syncVideos();
      }

      disconnectedCallback() {
        this.desktop?.removeEventListener('change', this.syncVideos);
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Hero de vídeo Cantinflas",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título y texto alternativo del logotipo"
    },
    {
      "type": "image_picker",
      "id": "title_image",
      "label": "Logotipo sobre el hero"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo de escritorio"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Vídeo móvil opcional"
    },
    {
      "type": "image_picker",
      "id": "cover",
      "label": "Imagen cuando no hay vídeo"
    },
    {
      "type": "text",
      "id": "cover_asset",
      "label": "Archivo del tema para respaldo"
    },
    {
      "type": "number",
      "id": "cover_width",
      "label": "Ancho del archivo",
      "default": 1920
    },
    {
      "type": "number",
      "id": "cover_height",
      "label": "Alto del archivo",
      "default": 1080
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproducción automática sin sonido",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Posición del texto",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Inferior izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "contact",
          "label": "Figura izquierda, título derecho"
        }
      ]
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#242424"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Degradado del fondo"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Oscurecer el fondo",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del título",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "select",
      "id": "subheading_align",
      "label": "Alineación del subtítulo",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del subtítulo"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Título escritorio",
      "min": 36,
      "max": 160,
      "step": 2,
      "default": 108
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Título móvil",
      "min": 26,
      "max": 66,
      "step": 2,
      "default": 42
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "Hero de vídeo Cantinflas"
    }
  ]
}
{% endschema %}
