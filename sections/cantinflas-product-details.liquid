<section class="cantinflas-details"
  style="--cd-background: {{ section.settings.background }}; --cd-text: {{ section.settings.text_color }};">
  <div class="cantinflas-details__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
    <div class="cantinflas-details__layout">
      <div>
        {% for block in section.blocks %}
          {% if section.settings.presentation == 'steps' and block.settings.text != blank or section.settings.presentation == 'steps' and block.settings.image != blank %}
            <details class="cantinflas-details__row" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}</summary>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1080 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1080' }}
              {% endif %}
              <div class="rte">{{ block.settings.text }}</div>
            </details>
          {% else %}
            <div class="cantinflas-details__row" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading | escape }}</h3>
              <div class="rte">{{ block.settings.text }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1080 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1080', sizes: '(min-width: 900px) 40vw, 100vw' }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cantinflas-details { background: var(--cd-background); color: var(--cd-text); padding-block: clamp(3rem, 5vw, 8rem); }
  .cantinflas-details__inner { width: min(86%, 1640px); margin-inline: auto; }
  .cantinflas-details h2, .cantinflas-details h3 { color: inherit; }
  .cantinflas-details h2 { font-size: clamp(2.8rem, 4vw, 6rem); }
  .cantinflas-details__layout { display: grid; gap: 3rem; align-items: start; }
  .cantinflas-details__row { border-bottom: 1px solid currentColor; padding-block: 1rem; }
  .cantinflas-details__row summary { cursor: pointer; font-weight: 700; }
  .cantinflas-details__layout img { width: 100%; height: auto; }
  @media (min-width: 900px) {
    .cantinflas-details__layout:has(> img) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Detalles Cantinflas",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introducción"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen lateral"
    },
    {
      "type": "select",
      "id": "presentation",
      "label": "Presentación",
      "default": "steps",
      "options": [
        {
          "value": "steps",
          "label": "Etapas plegables"
        },
        {
          "value": "rows",
          "label": "Filas de datos"
        }
      ]
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#242424"
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Etapa o dato",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de la etapa"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Detalles Cantinflas"
    }
  ]
}
{% endschema %}
