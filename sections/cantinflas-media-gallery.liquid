<section class="cantinflas-gallery cantinflas-gallery--{{ section.settings.layout }}" style="
  --cg-bg: {{ section.settings.background }};
  --cg-title: {{ section.settings.heading_color }};
  --cg-copy: {{ section.settings.intro_color }};
  --cg-title-align: {{ section.settings.heading_align }};
  --cg-copy-align: {{ section.settings.intro_align }};
  --cg-title-size: {{ section.settings.heading_size }}px;
  --cg-title-mobile: {{ section.settings.heading_mobile }}px;
  --cg-width: {{ section.settings.card_width }}px;
  --cg-height: {{ section.settings.card_height }}px;
  --cg-gap: {{ section.settings.gap }}px;
  --cg-padding: {{ section.settings.padding }}px;
">
  <header class="cantinflas-gallery__intro">
    {% if section.settings.heading != blank %}<h2 id="GalleryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<div class="cantinflas-gallery__description rte">{{ section.settings.intro }}</div>{% endif %}
  </header>
  <cantinflas-gallery-track>
    <div class="cantinflas-gallery__track" data-gallery-track tabindex="0" role="region"
      {% if section.settings.heading != blank %}aria-labelledby="GalleryTitle-{{ section.id }}"{% else %}aria-label="Galería"{% endif %}>
      <ul role="list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }} style="
            --cg-frame: {{ block.settings.frame }};
            --cg-caption: {{ block.settings.caption_color }};
            --cg-card-title: {{ block.settings.title_color }};
            --cg-caption-align: {{ block.settings.caption_align }};
            --cg-card-align: {{ block.settings.title_align }};
            --cg-angle: {{ block.settings.rotation }}deg;
          ">
            <figure>
              <div class="cantinflas-gallery__media">
                {% if block.settings.video != blank %}
                  {%- assign poster = block.settings.image | default: block.settings.video.preview_image -%}
                  {%- assign poster_url = poster | image_url: width: 960 -%}
                  {{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', poster: poster_url }}
                {% elsif block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 960 | image_tag: loading: 'lazy', widths: '300, 480, 720, 960', sizes: '(min-width: 900px) 30vw, 80vw' }}
                {% else %}
                  {% capture sample %}{% cycle 'image', 'lifestyle-1', 'lifestyle-2' %}{% endcapture %}
                  {{ sample | strip | placeholder_svg_tag: 'cantinflas-gallery__placeholder' }}
                {% endif %}
              </div>
              {% if block.settings.title != blank or block.settings.caption != blank %}
                <figcaption>
                  {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                  {% if block.settings.caption != blank %}<div class="rte">{{ block.settings.caption }}</div>{% endif %}
                </figcaption>
              {% endif %}
            </figure>
          </li>
        {% endfor %}
      </ul>
    </div>
    <div class="cantinflas-gallery__controls" data-gallery-controls hidden>
      <button type="button" aria-label="Anterior" data-gallery-prev>‹</button>
      <button type="button" aria-label="Siguiente" data-gallery-next>›</button>
    </div>
  </cantinflas-gallery-track>
</section>

{% stylesheet %}
  .cantinflas-gallery { background: var(--cg-bg); padding-block: var(--cg-padding); }
  .cantinflas-gallery__intro { width: min(90%, 164rem); margin: 0 auto; }
  .cantinflas-gallery__intro h2 { color: var(--cg-title); text-align: var(--cg-title-align); font-size: var(--cg-title-mobile); margin: 0 0 1rem; }
  .cantinflas-gallery__description { color: var(--cg-copy); text-align: var(--cg-copy-align); }
  .cantinflas-gallery__description p, .cantinflas-gallery figcaption p { color: inherit; }
  .cantinflas-gallery__track { overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; }
  .cantinflas-gallery__track ul { display: flex; width: max-content; min-width: 100%; justify-content: center; margin: 0; padding: 2.7rem max(1.25rem, 5vw); box-sizing: border-box; gap: var(--cg-gap); list-style: none; }
  .cantinflas-gallery__track li { flex: 0 0 min(var(--cg-width), 82vw); width: min(var(--cg-width), 82vw); scroll-snap-align: center; }
  .cantinflas-gallery figure { margin: 0; background: var(--cg-frame); padding: .9rem; box-shadow: 0 0.5rem 1.4rem rgb(0 0 0 / .18); transform: rotate(var(--cg-angle)); transition: transform .22s ease; }
  .cantinflas-gallery figure:focus-within, .cantinflas-gallery figure:hover { transform: rotate(0); }
  .cantinflas-gallery--film figure { box-shadow: none; padding: 0; }
  .cantinflas-gallery__media { height: min(var(--cg-height), 90vw); overflow: hidden; }
  .cantinflas-gallery__media :is(img, video, svg) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cantinflas-gallery figcaption { color: var(--cg-caption); text-align: var(--cg-caption-align); padding: .8rem .6rem .2rem; }
  .cantinflas-gallery figcaption h3 { color: var(--cg-card-title); text-align: var(--cg-card-align); font-size: 1.1em; margin: 0; }
  .cantinflas-gallery__controls:not([hidden]) { display: flex; justify-content: center; gap: .7rem; }
  .cantinflas-gallery__controls button { border: 1px solid currentColor; border-radius: 50%; width: 44px; height: 44px; font: inherit; color: var(--cg-title); background: transparent; }
  @media (min-width: 900px) { .cantinflas-gallery__intro h2 { font-size: var(--cg-title-size); } }
  @media (prefers-reduced-motion: reduce) { .cantinflas-gallery figure { transition: none; } }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cantinflas-gallery-track')) {
    customElements.define('cantinflas-gallery-track', class extends HTMLElement {
      connectedCallback() {
        const track = this.querySelector('[data-gallery-track]');
        const controls = this.querySelector('[data-gallery-controls]');
        if (!track || !controls) return;
        this.listeners = new AbortController();
        const { signal } = this.listeners;
        const update = () => { controls.hidden = track.scrollWidth <= track.clientWidth + 2; };
        const move = (direction) => {
          const motion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const step = track.querySelector('li')?.getBoundingClientRect().width || track.clientWidth;
          const gap = parseFloat(getComputedStyle(track.querySelector('ul')).columnGap) || 0;
          track.scrollBy({ left: direction * (step + gap), behavior: motion ? 'auto' : 'smooth' });
        };
        controls.querySelector('[data-gallery-prev]').addEventListener('click', () => move(-1), { signal });
        controls.querySelector('[data-gallery-next]').addEventListener('click', () => move(1), { signal });
        this.addEventListener('shopify:block:select', (event) => {
          event.target.closest('li')?.scrollIntoView({ block: 'nearest', inline: 'center' });
        }, { signal });
        this.resize = new ResizeObserver(update);
        this.resize.observe(track);
        this.resize.observe(track.querySelector('ul'));
        update();
      }

      disconnectedCallback() {
        this.listeners?.abort();
        this.resize?.disconnect();
      }
    });
  }
{% endjavascript %}

