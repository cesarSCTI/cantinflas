{% liquid
  assign desktop_count = section.settings.desktop_count | default: 0
  assign mobile_count = section.settings.mobile_count | default: 0
%}
<section class="cantinflas-gallery cantinflas-gallery--{{ section.settings.layout }}{% if section.settings.xd_centered %} cantinflas-gallery--centered{% elsif desktop_count > 0 %} cantinflas-gallery--fixed-desktop{% endif %}{% if mobile_count > 0 and section.settings.xd_centered == false %} cantinflas-gallery--fixed-mobile{% endif %}" style="
  --cg-bg: {{ section.settings.background }};
  --cg-title: {{ section.settings.heading_color }};
  --cg-copy: {{ section.settings.intro_color }};
  --cg-title-align: {{ section.settings.heading_align }};
  --cg-copy-align: {{ section.settings.intro_align }};
  --cg-title-size: {{ section.settings.heading_size }}px;
  --cg-title-mobile: {{ section.settings.heading_mobile }}px;
  --cg-width: {{ section.settings.card_width }}px;
  --cg-height: {{ section.settings.card_height }}px;
  --cg-gap: {{ section.settings.gap }}px;
  --cg-padding: {{ section.settings.padding }}px;
  --cg-navigation-text: {{ section.settings.navigation_color | default: section.settings.heading_color }};
  --cg-navigation-bg: {{ section.settings.navigation_background | default: 'transparent' }};
  {% if desktop_count > 0 %}--cg-desktop-count: {{ desktop_count }};{% endif %}
  {% if mobile_count > 0 %}--cg-mobile-count: {{ mobile_count }};{% endif %}
">
  <header class="cantinflas-gallery__intro">
    {% if section.settings.heading != blank %}<h2 id="GalleryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<div class="cantinflas-gallery__description rte">{{ section.settings.intro }}</div>{% endif %}
    {% if section.settings.xd_centered and section.settings.xd_decoration %}
      <div class="cantinflas-gallery__decoration">
        {% render 'cantinflas-agua-image', image: section.settings.xd_gallery_image, artwork: 'cartoon', alt: '' %}
      </div>
    {% endif %}
  </header>
  <cantinflas-gallery-track{% if section.settings.xd_centered %} data-centered="{{ section.settings.xd_initial_slide }}"{% endif %}{% if section.settings.infinite_loop %} data-gallery-loop{% endif %}>
    {% if section.settings.infinite_loop and section.settings.autoplay %}
      <button type="button" class="cantinflas-gallery__rotation" data-gallery-rotation hidden>Pausar rotación</button>
    {% endif %}
    <div class="cantinflas-gallery__track" data-gallery-track tabindex="0" role="region"
      {% if section.settings.heading != blank %}aria-labelledby="GalleryTitle-{{ section.id }}"{% else %}aria-label="Galería"{% endif %}>
      <ul role="list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }} style="
            --cg-frame: {{ block.settings.frame }};
            --cg-caption: {{ block.settings.caption_color }};
            --cg-card-title: {{ block.settings.title_color }};
            --cg-caption-align: {{ block.settings.caption_align }};
            --cg-card-align: {{ block.settings.title_align }};
            --cg-angle: {{ block.settings.rotation }}deg;
          ">
            <figure>
              <div class="cantinflas-gallery__media">
                {% if block.settings.video != blank %}
                  {%- assign poster = block.settings.image | default: block.settings.video.preview_image -%}
                  {%- assign poster_url = poster | image_url: width: 960 -%}
                  {{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', poster: poster_url }}
                {% elsif block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 960 | image_tag: loading: 'lazy', widths: '300, 480, 720, 960', sizes: '(min-width: 900px) 30vw, 80vw' }}
                {% elsif section.settings.xd_centered and block.settings.xd_artwork != blank and block.settings.xd_artwork != 'none' %}
                  {% render 'cantinflas-agua-image', artwork: block.settings.xd_artwork, alt: block.settings.title %}
                {% else %}
                  {% capture sample %}{% cycle 'image', 'lifestyle-1', 'lifestyle-2' %}{% endcapture %}
                  {{ sample | strip | placeholder_svg_tag: 'cantinflas-gallery__placeholder' }}
                {% endif %}
              </div>
              {% if block.settings.title != blank or block.settings.caption != blank %}
                <figcaption>
                  {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                  {% if block.settings.caption != blank %}<div class="rte">{{ block.settings.caption }}</div>{% endif %}
                </figcaption>
              {% endif %}
            </figure>
          </li>
        {% endfor %}
      </ul>
    </div>
    {% if section.settings.show_navigation %}
      <div class="cantinflas-gallery__controls" data-gallery-controls hidden>
        <button type="button" aria-label="Anterior" data-gallery-prev>‹</button>
        <button type="button" aria-label="Siguiente" data-gallery-next>›</button>
      </div>
    {% endif %}
  </cantinflas-gallery-track>
</section>

{% stylesheet %}
  .cantinflas-gallery { background: var(--cg-bg); padding-block: var(--cg-padding); }
  .cantinflas-gallery__intro { width: min(90%, 164rem); margin: 0 auto; }
  .cantinflas-gallery__intro h2 { color: var(--cg-title); text-align: var(--cg-title-align); font-size: var(--cg-title-mobile); margin: 0 0 1rem; }
  .cantinflas-gallery__description { color: var(--cg-copy); text-align: var(--cg-copy-align); }
  .cantinflas-gallery__description p, .cantinflas-gallery figcaption p { color: inherit; }
  .cantinflas-gallery__track {
    --cg-gutter: max(1.25rem, 5vw);
    --cg-visible: var(--cg-mobile-count, 0);
    --cg-basis: min(var(--cg-width), 82vw);
    container-type: inline-size;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--cg-gutter);
    overscroll-behavior-inline: contain;
  }
  .cantinflas-gallery__track ul { display: flex; width: max-content; min-width: 100%; justify-content: center; margin: 0; padding: 2.7rem var(--cg-gutter); box-sizing: border-box; gap: var(--cg-gap); list-style: none; }
  [data-gallery-loop] .cantinflas-gallery__track { overflow-anchor: none; }
  .cantinflas-gallery__track li { flex: 0 0 var(--cg-basis); width: var(--cg-basis); scroll-snap-align: start; }
  .cantinflas-gallery figure { margin: 0; background: var(--cg-frame); padding: .9rem; box-shadow: 0 0.5rem 1.4rem rgb(0 0 0 / .18); transform: rotate(var(--cg-angle)); transition: transform .22s ease; }
  .cantinflas-gallery figure:focus-within, .cantinflas-gallery figure:hover { transform: rotate(0); }
  .cantinflas-gallery--film figure { box-shadow: none; padding: 0; }
  .cantinflas-gallery--original .cantinflas-gallery__track { scrollbar-width: none; }
  .cantinflas-gallery--original .cantinflas-gallery__track::-webkit-scrollbar { display: none; }
  .cantinflas-gallery--original figure,
  .cantinflas-gallery--original figure:is(:hover, :focus-within) {
    padding: 0;
    background: transparent;
    box-shadow: none;
    transform: none;
    transition: none;
  }
  .cantinflas-gallery__media { height: min(var(--cg-height), 90vw); overflow: hidden; }
  .cantinflas-gallery__media :is(img, video, svg) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cantinflas-gallery--original .cantinflas-gallery__media :is(img, video, svg) { object-fit: contain; }
  .cantinflas-gallery figcaption { color: var(--cg-caption); text-align: var(--cg-caption-align); padding: .8rem .6rem .2rem; }
  .cantinflas-gallery figcaption h3 { color: var(--cg-card-title); text-align: var(--cg-card-align); font-size: 1.1em; margin: 0; }
  .cantinflas-gallery__controls:not([hidden]) { display: flex; justify-content: center; gap: .7rem; }
  .cantinflas-gallery__controls button { border: 1px solid currentColor; border-radius: 50%; width: 44px; height: 44px; font: inherit; color: var(--cg-navigation-text); background: var(--cg-navigation-bg); }
  .cantinflas-gallery__rotation:not([hidden]) { display: block; margin: 0 auto; padding: .55em 1em; border: 1px solid currentColor; border-radius: 2em; color: var(--cg-navigation-text); background: var(--cg-navigation-bg); }
  .cantinflas-gallery--centered .cantinflas-gallery__intro { position: relative; width: 90%; max-width: 1720px; padding-inline-end: min(16vw, 250px); }
  .cantinflas-gallery__decoration { position: absolute; inset: 0 7% auto auto; width: clamp(54px, 9vw, 175px); }
  .cantinflas-gallery__decoration img { display: block; width: 100%; height: auto; }
  .cantinflas-gallery--centered cantinflas-gallery-track { display: block; position: relative; }
  .cantinflas-gallery--centered .cantinflas-gallery__track { --cg-basis: min(var(--cg-width), 26.3vw); --cg-gutter: calc((100% - var(--cg-basis)) / 2); scroll-padding-inline: 0; scrollbar-width: none; }
  .cantinflas-gallery--centered .cantinflas-gallery__track ul { padding-inline: calc((100cqw - var(--cg-basis)) / 2); align-items: start; padding-block: clamp(28px, 5vw, 96px) 20px; }
  .cantinflas-gallery--centered .cantinflas-gallery__track li { scroll-snap-align: center; }
  .cantinflas-gallery--centered figure { padding: 0; box-shadow: none; background: transparent; }
  .cantinflas-gallery--centered .cantinflas-gallery__media { height: auto; aspect-ratio: 505 / 840; }
  .cantinflas-gallery--centered .cantinflas-gallery__media :is(img,video,svg) { border-radius: clamp(8px, 1.1vw, 20px); height: 81%; margin-block: 16% 0; transition: height .2s, margin .2s; }
  .cantinflas-gallery--centered [data-gallery-rebasing] .cantinflas-gallery__media :is(img,video,svg) { transition: none; }
  .cantinflas-gallery--centered [data-active] .cantinflas-gallery__media :is(img,video,svg) { height: 100%; margin-block: 0; }
  .cantinflas-gallery--centered figcaption { visibility: hidden; }
  .cantinflas-gallery--centered [data-active] figcaption { visibility: visible; }
  .cantinflas-gallery--centered .cantinflas-gallery__controls:not([hidden]) { position: absolute; top: 48%; inset-inline: 3%; justify-content: space-between; pointer-events: none; }
  .cantinflas-gallery--centered .cantinflas-gallery__controls button { pointer-events: auto; }
  @media (max-width: 749px) {
    .cantinflas-gallery--centered .cantinflas-gallery__track { --cg-basis: min(var(--cg-width), 72vw); }
    .cantinflas-gallery--centered .cantinflas-gallery__intro { padding-inline-end: 16vw; }
    .cantinflas-gallery__decoration { inset-inline-end: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .cantinflas-gallery--centered .cantinflas-gallery__media :is(img,video,svg) { transition: none; } }
  @media (max-width: 899px) {
    .cantinflas-gallery--fixed-mobile .cantinflas-gallery__track li {
      --cg-basis: calc((100cqw - 2 * var(--cg-gutter) - (var(--cg-visible) - 1) * var(--cg-gap)) / var(--cg-visible));
    }
  }
  @media (min-width: 900px) {
    .cantinflas-gallery__intro h2 { font-size: var(--cg-title-size); }
    .cantinflas-gallery__track { --cg-visible: var(--cg-desktop-count, 0); }
    .cantinflas-gallery--fixed-desktop .cantinflas-gallery__track li {
      --cg-basis: calc((100cqw - 2 * var(--cg-gutter) - (var(--cg-visible) - 1) * var(--cg-gap)) / var(--cg-visible));
    }
  }
  @media (prefers-reduced-motion: reduce) { .cantinflas-gallery figure { transition: none; } }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cantinflas-gallery-track')) {
    customElements.define('cantinflas-gallery-track', class extends HTMLElement {
      connectedCallback() {
        const track = this.querySelector('[data-gallery-track]');
        const controls = this.querySelector('[data-gallery-controls]');
        const list = track?.querySelector('ul');
        if (!list) return;
        this.listeners = new AbortController();
        const { signal } = this.listeners;
        const slides = [...list.children];
        if (this.hasAttribute('data-gallery-loop') && slides.length > 1) {
          this.connectLoop(track, list, controls, slides, signal);
          return;
        }
        this.addEventListener('shopify:block:select', (event) => {
          event.target.closest('li')?.scrollIntoView({ block: 'nearest', inline: 'center' });
        }, { signal });
        const centered = this.hasAttribute('data-centered');
        let active = Math.min(slides.length - 1, Math.max(0, (Number(this.dataset.centered) || 1) - 1));
        const update = () => { if (controls) controls.hidden = track.scrollWidth <= track.clientWidth + 2; };
        const select = (index, behavior) => {
          const slide = slides[index];
          if (!slide) return;
          const bounds = slide.getBoundingClientRect();
          const frame = track.getBoundingClientRect();
          track.scrollBy({ left: bounds.left + bounds.width / 2 - frame.left - frame.width / 2, behavior });
          slides.forEach((item, position) => item.toggleAttribute('data-active', position === index));
          active = index;
        };
        if (centered && slides.length) {
          select(active, 'instant');
          track.addEventListener('scroll', () => {
            const frame = track.getBoundingClientRect();
            const center = frame.left + frame.width / 2;
            let distance = Infinity;
            slides.forEach((slide, index) => {
              const bounds = slide.getBoundingClientRect();
              const delta = Math.abs(bounds.left + bounds.width / 2 - center);
              if (delta < distance) {
                active = index;
                distance = delta;
              }
            });
            slides.forEach((slide, index) => slide.toggleAttribute('data-active', index === active));
          }, { signal, passive: true });
        }
        const move = (direction) => {
          const motion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (centered && slides.length) {
            select((active + direction + slides.length) % slides.length, motion ? 'instant' : 'smooth');
            return;
          }
          const step = track.querySelector('li')?.getBoundingClientRect().width || track.clientWidth;
          const gap = parseFloat(getComputedStyle(list).columnGap) || 0;
          track.scrollBy({ left: direction * (step + gap), behavior: motion ? 'auto' : 'smooth' });
        };
        controls?.querySelector('[data-gallery-prev]')?.addEventListener('click', () => move(-1), { signal });
        controls?.querySelector('[data-gallery-next]')?.addEventListener('click', () => move(1), { signal });
        this.resize = new ResizeObserver(update);
        this.resize.observe(track);
        this.resize.observe(list);
        update();
      }

      connectLoop(track, list, controls, slides, signal) {
        const centered = this.hasAttribute('data-centered');
        const motion = matchMedia('(prefers-reduced-motion: reduce)');
        const slideSources = new Map(slides.map(slide => [slide, slide]));
        let items = slides;
        let active = slides[Math.min(slides.length - 1, Math.max(0, (Number(this.dataset.centered) || 1) - 1))];
        let selected = active;
        let destination;
        let copies = 0;
        let previousStep;
        let previousWidth;
        let settleTimer;
        let rebaseFrame;

        const offset = (slide, rtl) => {
          const card = slide.getBoundingClientRect();
          return centered ? card.left + card.width / 2 : rtl ? card.right : card.left;
        };
        const position = () => {
          const style = getComputedStyle(track);
          const bounds = track.getBoundingClientRect();
          const rtl = style.direction === 'rtl';
          const gutter = parseFloat(style.scrollPaddingInlineStart) || 0;
          const anchor = centered ? bounds.left + bounds.width / 2 : rtl ? bounds.right - gutter : bounds.left + gutter;
          return { rtl, anchor };
        };
        const nearest = () => {
          const { rtl, anchor } = position();
          let closest = active;
          let distance = Infinity;
          for (const slide of items) {
            const delta = Math.abs(offset(slide, rtl) - anchor);
            if (delta < distance) {
              closest = slide;
              distance = delta;
            }
          }
          return closest;
        };
        const highlight = (slide) => {
          if (active !== slide) active.removeAttribute('data-active');
          active = slide;
          active.setAttribute('data-active', '');
        };
        const align = (slide, behavior) => {
          const { rtl, anchor } = position();
          const distance = offset(slide, rtl) - anchor;
          // Native scroll snap can interpret a subpixel adjustment as a request for the adjacent slide.
          if (Math.abs(distance) > 1) track.scrollBy({ left: distance, behavior });
        };
        const rebase = (original) => {
          track.setAttribute('data-gallery-rebasing', '');
          align(original, 'instant');
          highlight(original);
          cancelAnimationFrame(rebaseFrame);
          rebaseFrame = requestAnimationFrame(() => {
            rebaseFrame = requestAnimationFrame(() => track.removeAttribute('data-gallery-rebasing'));
          });
        };
        const settle = () => {
          if (track.clientWidth !== previousWidth) return;
          const shown = nearest();
          selected = slideSources.get(shown);
          destination = undefined;
          if (shown !== selected) rebase(selected);
          else highlight(selected);
        };
        const move = (direction) => {
          if (!copies) return;
          let from = destination || nearest();
          if (!items[items.indexOf(from) + direction]) {
            from = slideSources.get(from);
            rebase(from);
          }
          destination = items[items.indexOf(from) + direction];
          align(destination, motion.matches ? 'instant' : 'smooth');
        };

        const makeCopy = (original) => {
          const copy = original.cloneNode(true);
          copy.removeAttribute('data-active');
          copy.removeAttribute('data-shopify-editor-block');
          copy.setAttribute('aria-hidden', 'true');
          copy.inert = true;
          copy.querySelectorAll('[id]').forEach(element => element.removeAttribute('id'));
          copy.querySelectorAll('video').forEach(video => {
            const poster = document.createElement('img');
            if (video.poster) poster.src = video.poster;
            poster.alt = '';
            poster.loading = 'lazy';
            video.replaceWith(poster);
          });
          slideSources.set(copy, original);
          return copy;
        };
        const removeCopies = () => {
          for (const [slide, original] of slideSources) {
            if (slide === original) continue;
            slide.remove();
            slideSources.delete(slide);
          }
        };
        const refresh = () => {
          const step = Math.abs(slides[1].getBoundingClientRect().left - slides[0].getBoundingClientRect().left);
          const width = track.clientWidth;
          if (!step || !width || (step === previousStep && width === previousWidth)) return;
          previousStep = step;
          previousWidth = width;
          selected = destination ? slideSources.get(destination) : selected;
          const needed = Math.max(1, Math.ceil(width / (step * slides.length)));
          if (needed !== copies) {
            removeCopies();
            const before = document.createDocumentFragment();
            const after = document.createDocumentFragment();
            for (let cycle = 0; cycle < needed; cycle++) {
              slides.forEach(slide => before.append(makeCopy(slide)));
              slides.forEach(slide => after.append(makeCopy(slide)));
            }
            list.prepend(before);
            list.append(after);
            items = [...list.children];
            copies = needed;
          }
          destination = undefined;
          align(selected, 'instant');
          highlight(selected);
          if (controls) controls.hidden = false;
        };

        const hasScrollEnd = 'onscrollend' in track;
        track.addEventListener('scroll', () => {
          highlight(nearest());
          if (!hasScrollEnd) {
            clearTimeout(settleTimer);
            settleTimer = setTimeout(settle, 140);
          }
        }, { signal, passive: true });
        if (hasScrollEnd) track.addEventListener('scrollend', settle, { signal });
        track.addEventListener('pointerdown', () => { destination = undefined; }, { signal });
        track.addEventListener('keydown', (event) => {
          if (event.target !== track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          const rtl = getComputedStyle(track).direction === 'rtl';
          move((event.key === 'ArrowRight') === rtl ? -1 : 1);
        }, { signal });
        this.addEventListener('shopify:block:select', (event) => {
          const slide = event.target.closest('li');
          if (!slides.includes(slide)) return;
          destination = undefined;
          selected = slide;
          align(slide, 'instant');
          highlight(slide);
        }, { signal });
        controls?.querySelector('[data-gallery-prev]')?.addEventListener('click', () => move(-1), { signal });
        controls?.querySelector('[data-gallery-next]')?.addEventListener('click', () => move(1), { signal });
        signal.addEventListener('abort', () => {
          clearTimeout(settleTimer);
          cancelAnimationFrame(rebaseFrame);
          track.removeAttribute('data-gallery-rebasing');
          removeCopies();
        }, { once: true });
        this.resize = new ResizeObserver(refresh);
        this.resize.observe(track);
        this.resize.observe(slides[0]);
        refresh();
        this.connectRotation(track, move, motion, signal);
      }

      connectRotation(track, move, motion, signal) {
        const control = this.querySelector('[data-gallery-rotation]');
        if (!control) return;
        let playing = true;
        let hovered = false;
        let visible = false;
        const update = () => {
          control.hidden = motion.matches;
          control.textContent = playing ? 'Pausar rotación' : 'Reanudar rotación';
        };
        const pause = () => {
          playing = false;
          update();
        };
        control.addEventListener('click', () => {
          playing = !playing;
          update();
        }, { signal });
        this.addEventListener('focusin', (event) => {
          if (event.target.matches(':focus-visible')) pause();
        }, { signal });
        this.addEventListener('pointerenter', (event) => { hovered = event.pointerType === 'mouse'; }, { signal });
        this.addEventListener('pointerleave', () => { hovered = false; }, { signal });
        track.addEventListener('pointerdown', pause, { signal });
        track.addEventListener('play', pause, { signal, capture: true });
        this.addEventListener('shopify:block:select', pause, { signal });
        motion.addEventListener('change', update, { signal });
        const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; });
        observer.observe(track);
        const timer = setInterval(() => {
          if (playing && visible && !hovered && !document.hidden && !motion.matches) move(1);
        }, 4500);
        signal.addEventListener('abort', () => {
          observer.disconnect();
          clearInterval(timer);
        }, { once: true });
        update();
      }

      disconnectedCallback() {
        this.listeners?.abort();
        this.resize?.disconnect();
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Galería multimedia",
  "max_blocks": 12,
  "settings": [
    {"type":"checkbox","id":"xd_centered","label":"Destacar la imagen central","default":false},
    {"type":"range","id":"xd_initial_slide","label":"Imagen inicial","min":1,"max":12,"step":1,"default":1},
    {"type":"checkbox","id":"xd_decoration","label":"Mostrar ilustración lateral","default":false},
    {"type":"image_picker","id":"xd_gallery_image","label":"Ilustración lateral"},
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Galería"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introducción"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#c22921"
    },
    {
      "type": "color",
      "id": "intro_color",
      "label": "Color de introducción",
      "default": "#252525"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del título",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "select",
      "id": "intro_align",
      "label": "Alineación de introducción",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Título escritorio",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_mobile",
      "label": "Título móvil",
      "min": 16,
      "max": 70,
      "step": 2,
      "default": 32
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Marco",
      "default": "photo",
