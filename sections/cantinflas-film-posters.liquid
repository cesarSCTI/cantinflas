      "step": 1,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "stagger",
      "label": "Desnivel de los carteles",
      "min": 0,
      "max": 56,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "checkbox",
