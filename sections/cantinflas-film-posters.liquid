          "label": "Fondo del cartel",
          "default": "#f4ede1"
        },
        {
          "type": "color",
          "id": "caption_color",
          "label": "Color del pie",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Color del título"
        },
        {
          "type": "select",
          "id": "title_align",
          "label": "Alineación del título",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Izquierda"
            },
            {
              "value": "center",
              "label": "Centro"
            },
