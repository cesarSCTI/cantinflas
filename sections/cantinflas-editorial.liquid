{% if section.settings.layout == 'filmstrip' %}
  {% render 'cantinflas-museum-origins', section: section %}
{% else %}
{% liquid
  assign column_order = section.settings.column_order | default: 'alternate'
  assign full_hotspot = false
  assign overlay_hotspot_copy = false
  if section.settings.layout == 'hotspots'
    assign full_hotspot = section.settings.hotspot_full_width
    assign overlay_hotspot_copy = section.settings.hotspot_overlay_copy
  endif
%}
{% if section.settings.card_purchase_buttons %}
  <script src="{{ 'product-form.js' | asset_url }}" defer></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
  <script src="{{ 'variant-dropdown.js' | asset_url }}" defer></script>
{% endif %}
{%- capture editorial_copy -%}
    {% if section.settings.heading != blank %}
      <h2 class="cantinflas-editorial__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.intro != blank %}
      <div class="cantinflas-editorial__intro rte">{{ section.settings.intro }}</div>
    {% endif %}
{%- endcapture -%}
{% liquid
  assign column_heading_pending = false
  if section.settings.heading_in_copy and section.settings.layout == 'alternating' and editorial_copy != blank
    assign editorial_items = section.blocks | where: 'type', 'item'
    if editorial_items.size > 0
      assign column_heading_pending = true
    endif
  endif
%}
<section class="cantinflas-editorial cantinflas-editorial--{{ section.settings.layout }}{% if section.settings.layout == 'alternating' %} cantinflas-editorial--order-{{ column_order }}{% endif %}{% if full_hotspot %} cantinflas-editorial--hotspot-full{% endif %}"
  {% if section.settings.layout == 'collage' and section.settings.collage_motion %}data-collage-motion{% endif %}
  style="--ce-background: {{ section.settings.background }}; --ce-text: {{ section.settings.text_color }}; --ce-accent: {{ section.settings.accent }}; --ce-intro: {{ section.settings.intro_color | default: section.settings.text_color }}; --ce-head-align: {{ section.settings.heading_align }}; --ce-intro-align: {{ section.settings.intro_align }}; --ce-mobile: {{ section.settings.heading_mobile }}px; --ce-desktop: {{ section.settings.heading_size }}px;">
  <div class="cantinflas-editorial__inner{% if section.settings.layout == 'collage' and section.blocks.size <= 8 %} cantinflas-editorial__inner--framed{% endif %}">
    {% if section.settings.layout == 'collage' %}<div class="cantinflas-editorial__collage-copy">{% endif %}
    {% unless overlay_hotspot_copy or column_heading_pending %}{{ editorial_copy }}{% endunless %}
    {% if section.settings.layout == 'collage' %}
        <div class="cantinflas-editorial__collage-actions">
          {% for number in (1..2) %}
            {% assign label_setting = 'collage_label_' | append: number %}
            {% assign link_setting = 'collage_link_' | append: number %}
            {% assign background_setting = 'collage_button_bg_' | append: number %}
            {% assign text_setting = 'collage_button_text_' | append: number %}
            {% assign label = section.settings[label_setting] %}
            {% assign link = section.settings[link_setting] %}
            {% if label != blank %}
              {% capture action_style %}--ce-action-bg: {{ section.settings[background_setting] }}; --ce-action-text: {{ section.settings[text_setting] }};{% endcapture %}
              {% if link != blank %}
                <a class="cantinflas-editorial__collage-button" href="{{ link }}" style="{{ action_style }}">{{ label | escape }}</a>
              {% else %}
                <button class="cantinflas-editorial__collage-button" type="button" disabled style="{{ action_style }}">{{ label | escape }}</button>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
    {% if section.settings.layout == 'hotspots' %}
      <div class="cantinflas-editorial__hotspot-stage">
        <div class="cantinflas-editorial__hotspot-canvas">
          {% if section.settings.focus_image != blank %}
            {% assign hotspot_sizes = '(min-width: 1260px) 1080px, 86vw' %}
            {% if full_hotspot %}{% assign hotspot_sizes = '100vw' %}{% endif %}
            {{ section.settings.focus_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '480, 720, 1080, 1440, 1920, 2400', sizes: hotspot_sizes }}
          {% elsif section.settings.hotspot_anatomy_image %}
            <img src="{{ 'cantinflas-xd-anatomia.webp' | asset_url }}" alt="Collage de Cantinflas con un micrófono y una cinta de película" width="1671" height="941" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'cantinflas-editorial__placeholder' }}
          {% endif %}
          <div class="cantinflas-editorial__hotspot-layer">
            {% for block in section.blocks %}
              {% liquid
                assign marker_heading = block.settings.heading | default: 'Punto interactivo'
                assign marker_url = block.settings.link
                assign marker_label = block.settings.label | default: 'Ver más'
              %}
              <details name="Hotspots-{{ section.id }}" class="cantinflas-editorial__hotspot{% if block.settings.marker_y > 50 %} cantinflas-editorial__hotspot--above{% endif %}" {{ block.shopify_attributes }} style="
                --ce-x: {{ block.settings.marker_x }}%;
                --ce-y: {{ block.settings.marker_y }}%;
                --ce-dot: {{ block.settings.marker_color | default: '#c22921' }};
                --ce-dot-text: {{ block.settings.marker_text_color | default: '#ffffff' }};
                --ce-panel: {{ block.settings.card_color | default: '#ffffff' }};
                --ce-panel-heading: {{ block.settings.title_color | default: section.settings.accent }};
                --ce-panel-copy: {{ block.settings.copy_color | default: section.settings.text_color }};
                --ce-panel-link: {{ block.settings.button_color | default: section.settings.accent }};
              ">
                <summary aria-label="{{ marker_heading | escape }}">
                  <span class="cantinflas-editorial__hotspot-plus" aria-hidden="true">+</span>
                  <span class="cantinflas-editorial__hotspot-minus" aria-hidden="true">−</span>
                </summary>
                <div class="cantinflas-editorial__hotspot-panel">
                  <h3>{{ marker_heading | escape }}</h3>
                  {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
                  {% if marker_url != blank %}<a href="{{ marker_url }}">{{ marker_label | escape }}</a>{% endif %}
                </div>
              </details>
            {% endfor %}
          </div>
        </div>
        {% if overlay_hotspot_copy and editorial_copy != blank %}
          <div class="cantinflas-editorial__hotspot-copy">{{ editorial_copy }}</div>
        {% endif %}
      </div>
    {% else %}
    {% if section.settings.show_focus or section.settings.focus_image != blank %}
      <div class="cantinflas-editorial__focus">
        {% if section.settings.focus_image != blank %}
          {{ section.settings.focus_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 1080, 1600' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'cantinflas-editorial__placeholder' }}
        {% endif %}
      </div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <div class="cantinflas-editorial__items">
        {% for block in section.blocks %}
          {% unless block.type == 'item' %}{% continue %}{% endunless %}
          {% assign show_column_heading = column_heading_pending %}
          {% assign column_heading_pending = false %}
          {% assign card_product = block.settings.product %}
          {% assign card_url = block.settings.link | default: card_product.url %}
          {% assign card_title = block.settings.heading | default: card_product.title %}
          {% assign card_image = block.settings.image | default: card_product.featured_image %}
          <article class="cantinflas-editorial__item" {{ block.shopify_attributes }} style="
            --ce-card: {{ block.settings.card_color | default: 'transparent' }};
            --ce-card-title: {{ block.settings.title_color | default: section.settings.accent }};
            --ce-card-copy: {{ block.settings.copy_color | default: section.settings.text_color }};
            --ce-link: {{ block.settings.button_color | default: section.settings.text_color }};
            {% if section.settings.card_purchase_buttons %}
              --ce-purchase-bg: {{ section.settings.card_purchase_bg }};
              --ce-purchase-text: {{ block.settings.button_color | default: '#ffffff' }};
            {% endif %}
            --ce-title-align: {{ block.settings.title_align }};
            --ce-copy-align: {{ block.settings.text_align }};
            --ce-link-align: {{ block.settings.button_align }};
          ">
            {% capture card_copy %}
              {% if show_column_heading or card_title != blank or block.settings.text != blank or block.settings.label != blank %}
                  <div class="cantinflas-editorial__copy">
                    {% if show_column_heading %}{{ editorial_copy }}{% endif %}
                    {% if card_title != blank %}<h3>{{ card_title | escape }}</h3>{% endif %}
                    {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
                    {% if block.settings.label != blank %}
                      <div class="cantinflas-editorial__action">
                        {% if section.settings.card_purchase_buttons %}
                          <div class="cantinflas-editorial__purchase">
                            {% if card_product == blank %}
                              <button class="cantinflas-editorial__purchase-button" type="button" disabled>{{ 'products.product.unavailable' | t }}</button>
                            {% elsif card_product.requires_selling_plan or card_product.gift_card? %}
                              <a class="cantinflas-editorial__purchase-button" href="{{ card_product.url }}">{{ block.settings.label | escape }}</a>
                            {% else %}
                              {% assign card_form_id = 'EditorialPurchase-' | append: section.id | append: '-' | append: block.id %}
                              {% render 'quick-add-button',
                                card_product: card_product,
                                product: card_product,
                                product_form_id: card_form_id,
                                quick_add_label: block.settings.label
                              %}
                            {% endif %}
                          </div>
                        {% elsif card_url != blank %}
                          <a class="cantinflas-editorial__link" href="{{ card_url }}">{{ block.settings.label | escape }}</a>
                        {% elsif request.design_mode %}
                          <button class="cantinflas-editorial__link" type="button" disabled>{{ block.settings.label | escape }}</button>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
              {% endif %}
            {% endcapture %}
            {% if section.settings.layout == 'alternating' and column_order == 'text_first' %}
              {{ card_copy }}
            {% endif %}
            {% unless block.settings.hide_media %}
              <div class="cantinflas-editorial__media">
                {% if block.settings.video != blank %}
                  {% assign poster = block.settings.image | default: block.settings.video.preview_image %}
                  {% assign poster_url = poster | image_url: width: 1200 %}
                  {{ block.settings.video | video_tag: controls: true, preload: 'none', playsinline: true, poster: poster_url }}
                {% elsif card_image != blank %}
                  {{ card_image | image_url: width: 1440 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1080, 1440', sizes: '(min-width: 900px) 45vw, 100vw' }}
                {% elsif block.settings.image_asset != blank %}
                  <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="{{ block.settings.image_width }}" height="{{ block.settings.image_height }}" loading="lazy">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'cantinflas-editorial__placeholder' }}
                {% endif %}
              </div>
            {% endunless %}
            {% unless section.settings.layout == 'alternating' and column_order == 'text_first' %}
              {{ card_copy }}
            {% endunless %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
    {% endif %}
  </div>
</section>
{% endif %}

{% stylesheet %}
  .cantinflas-editorial { background: var(--ce-background); color: var(--ce-text); padding: clamp(3rem, 5vw, 9rem) 0; }
  .cantinflas-editorial__inner { width: min(86%, 1640px); margin-inline: auto; }
  .cantinflas-editorial h2, .cantinflas-editorial h3 { color: var(--ce-accent); line-height: 1.08; }
  .cantinflas-editorial h2 { text-align: var(--ce-head-align); font-size: var(--ce-mobile); margin: 0 0 1.6rem; }
  .cantinflas-editorial h3 { color: var(--ce-card-title); text-align: var(--ce-title-align); font-size: clamp(2rem, 2.2vw, 3.8rem); margin: 0 0 1rem; }
  .cantinflas-editorial__items { display: grid; gap: clamp(2rem, 4vw, 7rem); margin-top: 2.4rem; }
  .cantinflas-editorial__item img { display: block; width: 100%; height: auto; }
  .cantinflas-editorial__item img + .cantinflas-editorial__copy { margin-top: 1.6rem; }
  .cantinflas-editorial__link { display: inline-block; margin-top: 1.4rem; color: inherit; text-underline-offset: .2em; }
  @media (min-width: 600px) {
    .cantinflas-editorial--cards .cantinflas-editorial__items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 899px) {
    .cantinflas-editorial--order-text_first .cantinflas-editorial__item {
      display: grid;
      gap: 1.5rem;
    }
  }
  @media (min-width: 900px) {
    .cantinflas-editorial--cards .cantinflas-editorial__items { grid-template-columns: repeat(auto-fit, minmax(min(100%, 27rem), 1fr)); }
    .cantinflas-editorial--alternating .cantinflas-editorial__item { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 5vw; }
    .cantinflas-editorial--order-alternate .cantinflas-editorial__item:nth-child(even) .cantinflas-editorial__media { grid-column: 2; grid-row: 1; }
    .cantinflas-editorial--order-alternate .cantinflas-editorial__item:nth-child(even) .cantinflas-editorial__copy { grid-column: 1; grid-row: 1; }
    .cantinflas-editorial--alternating .cantinflas-editorial__copy:only-child { grid-column: 1 / -1; }
  }

  .cantinflas-editorial__intro { color: var(--ce-intro); text-align: var(--ce-intro-align); }
  .cantinflas-editorial__item { background: var(--ce-card); min-width: 0; }
  .cantinflas-editorial__copy { color: var(--ce-card-copy); text-align: var(--ce-copy-align); }
  .cantinflas-editorial__copy summary { cursor: pointer; color: var(--ce-card-title); text-align: var(--ce-title-align); }
  .cantinflas-editorial__copy p, .cantinflas-editorial__intro p { color: inherit; }
  .cantinflas-editorial__action { text-align: var(--ce-link-align); }
  .cantinflas-editorial__action a { color: var(--ce-link); }
  .cantinflas-editorial__purchase { display: inline-block; margin-top: 1.4rem; width: min(100%, 15rem); }
  .cantinflas-editorial__purchase product-form { margin: 0; }
  .cantinflas-editorial__purchase :is(.hero__button--secondary, .cantinflas-editorial__purchase-button) {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 44px;
    padding: .6rem 1.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--ce-purchase-bg);
    color: var(--ce-purchase-text);
    font: inherit;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
    text-decoration: none;
  }
  .cantinflas-editorial__purchase :is(button, a):hover:not(:disabled) {
    background: var(--ce-purchase-bg);
    color: var(--ce-purchase-text);
    filter: brightness(.9);
  }
  .cantinflas-editorial__purchase button:disabled { opacity: .55; cursor: default; }
  .cantinflas-editorial__media :is(svg, video), .cantinflas-editorial__focus :is(img, svg) { display: block; width: 100%; height: auto; }
  .cantinflas-editorial__placeholder { aspect-ratio: 4 / 3; background: #f4ede1; }
  .cantinflas-editorial__focus { margin: 2.6rem auto; width: min(100%, 108rem); }
  .cantinflas-editorial--orbit .cantinflas-editorial__focus { width: min(80%, 36rem); }
  .cantinflas-editorial--rail .cantinflas-editorial__items { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; }
  .cantinflas-editorial--rail article { flex: 0 0 clamp(19rem, 32vw, 39rem); scroll-snap-align: start; }
  @media (min-width: 900px) {
    .cantinflas-editorial h2 { font-size: var(--ce-desktop); }
    .cantinflas-editorial--duo .cantinflas-editorial__item { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 4vw; align-items: center; }
    .cantinflas-editorial--orbit .cantinflas-editorial__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; column-gap: 4rem; }
    .cantinflas-editorial--orbit :is(.cantinflas-editorial__heading,.cantinflas-editorial__intro) { grid-column: 1 / -1; }
    .cantinflas-editorial--orbit .cantinflas-editorial__items { grid-template-columns: repeat(2,minmax(0, 1fr)); }
  }


  .cantinflas-editorial--feature .cantinflas-editorial__media :is(img,video,svg) { aspect-ratio: 16 / 8; object-fit: cover; }
  @media (min-width: 900px) {
    .cantinflas-editorial--duo .cantinflas-editorial__inner:has(> .cantinflas-editorial__focus) {
      display: grid;
      grid-template-columns: minmax(0,1fr) minmax(0,4fr);
      column-gap: 4vw;
      align-items: center;
    }
    .cantinflas-editorial--duo :is(.cantinflas-editorial__heading,.cantinflas-editorial__intro) { grid-column: 1 / -1; }
    .cantinflas-editorial--duo .cantinflas-editorial__item .cantinflas-editorial__media { grid-column: 2; grid-row: 1; }
    .cantinflas-editorial--duo .cantinflas-editorial__item .cantinflas-editorial__copy { grid-column: 1; grid-row: 1; }
    .cantinflas-editorial--orbit .cantinflas-editorial__inner { grid-template-columns: minmax(0,1fr) minmax(0,1fr) minmax(0,1fr); }
    .cantinflas-editorial--orbit .cantinflas-editorial__focus { grid-area: 3 / 2; }
    .cantinflas-editorial--orbit .cantinflas-editorial__items { display: contents; }
    .cantinflas-editorial--orbit .cantinflas-editorial__item:nth-child(odd) { grid-column: 1; }
    .cantinflas-editorial--orbit .cantinflas-editorial__item:nth-child(even) { grid-column: 3; }
    .cantinflas-editorial--orbit .cantinflas-editorial__item:nth-child(-n+2) { grid-row: 3; }
  }

  .cantinflas-editorial--collage { padding-block: clamp(2rem, 3vw, 5rem); }
  .cantinflas-editorial--collage .cantinflas-editorial__inner { width: min(94%, 188rem); }
  .cantinflas-editorial--collage .cantinflas-editorial__items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .cantinflas-editorial--collage .cantinflas-editorial__intro p { margin: 0; }
  .cantinflas-editorial__collage-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .9rem; margin-top: 1.3rem; }
  .cantinflas-editorial__collage-button {
    display: inline-flex; justify-content: center; align-items: center;
    box-sizing: border-box; min-height: 44px; padding: .45rem 1.5rem;
    border: none; border-radius: 999px; background: var(--ce-action-bg); color: var(--ce-action-text);
    font: 700 clamp(1.2rem, 1.15vw, 2rem)/1.15 var(--font-base, sans-serif); text-decoration: none;
  }
  .cantinflas-editorial__collage-button:disabled { cursor: default; }
  @media (min-width: 600px) {
    .cantinflas-editorial--collage .cantinflas-editorial__items { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .cantinflas-editorial--collage:has(.cantinflas-editorial__inner--framed) { padding: 0; }
    .cantinflas-editorial--collage .cantinflas-editorial__inner--framed {
      display: grid;
      align-items: center;
      justify-items: center;
      position: relative;
      width: min(100%, 1920px);
      min-height: max(470px, min(56.8vw, 1090px));
      box-sizing: border-box;
    }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__collage-copy { width: 44%; z-index: 1; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__heading { font-size: min(var(--ce-desktop), 6.4vw); text-wrap: balance; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__intro {
      font-size: clamp(1.3rem, 1.3vw, 2.4rem);
      line-height: 1.38;
    }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__items { display: contents; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item {
      position: absolute;
      left: var(--ce-slot-x);
      top: var(--ce-slot-y);
      width: var(--ce-slot-width);
    }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__media :is(img, video, svg) {
      width: 100%;
      aspect-ratio: var(--ce-slot-ratio);
      height: auto;
      object-fit: cover;
    }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(1) { --ce-slot-x: 6.7%; --ce-slot-y: 17.3%; --ce-slot-width: 16.7%; --ce-slot-ratio: 131 / 186; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(2) { --ce-slot-x: 27.7%; --ce-slot-y: 7.2%; --ce-slot-width: 16.4%; --ce-slot-ratio: 129 / 81; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(3) { --ce-slot-x: 56.9%; --ce-slot-y: 5.6%; --ce-slot-width: 10.4%; --ce-slot-ratio: 81 / 109; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(4) { --ce-slot-x: 72%; --ce-slot-y: 11%; --ce-slot-width: 21.8%; --ce-slot-ratio: 171 / 125; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(5) { --ce-slot-x: 83.5%; --ce-slot-y: 51%; --ce-slot-width: 12.3%; --ce-slot-ratio: 96 / 127; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(6) { --ce-slot-x: 70.3%; --ce-slot-y: 68%; --ce-slot-width: 10.4%; --ce-slot-ratio: 81 / 121; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(7) { --ce-slot-x: 43.5%; --ce-slot-y: 76%; --ce-slot-width: 15.3%; --ce-slot-ratio: 120 / 81; }
    .cantinflas-editorial__inner--framed .cantinflas-editorial__item:nth-child(8) { --ce-slot-x: 9.4%; --ce-slot-y: 70.5%; --ce-slot-width: 21.1%; --ce-slot-ratio: 165 / 99; }
  }


  .cantinflas-editorial__hotspot-stage {
    position: relative;
    isolation: isolate;
    width: min(100%, 108rem);
    margin: 2.6rem auto;
  }
  .cantinflas-editorial--hotspot-full { padding: 0; overflow-x: clip; }
  .cantinflas-editorial--hotspot-full .cantinflas-editorial__inner { width: 100%; }
  .cantinflas-editorial--hotspot-full .cantinflas-editorial__hotspot-stage { width: 100%; margin: 0; }
  .cantinflas-editorial--hotspot-full .cantinflas-editorial__inner > :is(.cantinflas-editorial__heading, .cantinflas-editorial__intro) {
    margin-inline: auto;
    width: min(86%, 1640px);
  }

  .cantinflas-editorial__hotspot-canvas { position: relative; }
  .cantinflas-editorial__hotspot-canvas > :is(img, svg) { display: block; width: 100%; height: auto; }
  .cantinflas-editorial__hotspot-copy { padding: 1.5rem 8%; }
  .cantinflas-editorial__hotspot-copy .cantinflas-editorial__heading { margin: 0; text-wrap: balance; }
  .cantinflas-editorial__hotspot-copy .cantinflas-editorial__intro { font-weight: 600; }
  .cantinflas-editorial__hotspot-copy .cantinflas-editorial__intro p { margin-block: 0; }

  @media (min-width: 900px) {
    .cantinflas-editorial__hotspot-copy {
      position: absolute;
      inset: auto 8% 8%;
      display: grid;
      grid-template-columns: minmax(0, 35%) minmax(0, 38%);
      justify-content: space-between;
      align-items: end;
      padding: 0;
    }

    .cantinflas-editorial__hotspot-copy .cantinflas-editorial__heading { font-size: min(var(--ce-desktop), 4vw); }
    .cantinflas-editorial__hotspot-copy .cantinflas-editorial__intro { grid-column: 2; font-size: clamp(14px, 1.4vw, 24px); line-height: 1.2; }
    .cantinflas-editorial__hotspot-copy .cantinflas-editorial__intro p { font-size: inherit; }
  }
  .cantinflas-editorial__hotspot-layer { position: absolute; inset: 0; pointer-events: none; }
  .cantinflas-editorial__hotspot summary {
    position: absolute;
    top: var(--ce-y);
    left: var(--ce-x);
    z-index: 1;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2px solid currentColor;
    border-radius: 50%;
    background: var(--ce-dot);
    color: var(--ce-dot-text);
    font: 700 25px/1 var(--font-base, sans-serif);
    list-style: none;
    cursor: pointer;
    pointer-events: auto;
  }
  .cantinflas-editorial--hotspot-full .cantinflas-editorial__hotspot summary {
    border: 0;
    background: transparent;
    font-size: 17px;
  }

  .cantinflas-editorial--hotspot-full .cantinflas-editorial__hotspot summary::before {
    content: '';
    grid-area: 1 / 1;
    box-sizing: border-box;
    width: clamp(24px, 2.3vw, 32px);
    aspect-ratio: 1;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--ce-dot);
  }

  .cantinflas-editorial--hotspot-full .cantinflas-editorial__hotspot summary span { grid-area: 1 / 1; z-index: 1; }
  .cantinflas-editorial__hotspot summary::-webkit-details-marker { display: none; }
  .cantinflas-editorial__hotspot-minus, .cantinflas-editorial__hotspot[open] .cantinflas-editorial__hotspot-plus { display: none; }
  .cantinflas-editorial__hotspot[open] .cantinflas-editorial__hotspot-minus { display: block; }
  .cantinflas-editorial__hotspot[open] summary { z-index: 3; }
  .cantinflas-editorial__hotspot-panel {
    --ce-panel-width: min(24rem, 100%);
    position: absolute;
    z-index: 2;
    left: clamp(0px, calc(var(--ce-x) - var(--ce-panel-width) / 2), calc(100% - var(--ce-panel-width)));
    top: calc(var(--ce-y) + 27px);
    width: var(--ce-panel-width);
    box-sizing: border-box;
    padding: 1.25rem;
    border-radius: .65rem;
    background: var(--ce-panel);
    color: var(--ce-panel-copy);
    box-shadow: 0 .25rem 1rem rgb(0 0 0 / .24);
    overflow-wrap: anywhere;
    pointer-events: auto;
  }
  .cantinflas-editorial__hotspot--above .cantinflas-editorial__hotspot-panel {
    top: auto;
    bottom: calc(100% - var(--ce-y) + 27px);
  }
  .cantinflas-editorial__hotspot-panel h3 { margin: 0 0 .6rem; color: var(--ce-panel-heading); text-align: start; }
  .cantinflas-editorial__hotspot-panel :is(p, li) { color: inherit; }
  .cantinflas-editorial__hotspot-panel a { color: var(--ce-panel-link); text-decoration: underline; }

  @media (prefers-reduced-motion: no-preference) {
    .cantinflas-editorial[data-collage-motion] .cantinflas-editorial__media :is(img, svg) {
      animation: cantinflas-collage-float 4.4s ease-in-out var(--ce-float-delay, 0s) infinite;
    }
    .cantinflas-editorial[data-collage-motion] .cantinflas-editorial__item:nth-child(even) {
      --ce-float-delay: .24s;
      --ce-float-x: 4px;
      --ce-float-y: 6px;
    }
    .cantinflas-editorial[data-collage-motion] .cantinflas-editorial__item:nth-child(3n) {
      --ce-float-delay: .48s;
      --ce-float-x: -5px;
      --ce-float-y: -4px;
    }
    @keyframes cantinflas-collage-float {
      0%, 100% { translate: 0 0; }
      48% { translate: var(--ce-float-x, -3px) var(--ce-float-y, -7px); }
    }
  }
{% endstylesheet %}

