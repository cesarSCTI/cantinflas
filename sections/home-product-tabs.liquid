{% if section.settings.xd_text_controls %}
  {% style %}
    #shopify-section-{{ section.id }} .cantinflas-product-tabs > h2 {
      {% if section.settings.xd_heading_color != blank %}color: {{ section.settings.xd_heading_color }};{% endif %}
      {% unless section.settings.xd_heading_align == 'inherit' %}text-align: {{ section.settings.xd_heading_align }};{% endunless %}
    }
    #shopify-section-{{ section.id }} .cantinflas-tabs-intro {
      {% if section.settings.xd_body_color != blank %}color: {{ section.settings.xd_body_color }};{% endif %}
      {% unless section.settings.xd_body_align == 'inherit' %}text-align: {{ section.settings.xd_body_align }};{% endunless %}
    }
    #shopify-section-{{ section.id }} [data-tab-list] button {
      {% if section.settings.xd_tabs_color != blank %}color: {{ section.settings.xd_tabs_color }};{% endif %}
      {% unless section.settings.xd_tabs_align == 'inherit' %}text-align: {{ section.settings.xd_tabs_align }};{% endunless %}
    }
    #shopify-section-{{ section.id }} .card__title, #shopify-section-{{ section.id }} .card__title a, #shopify-section-{{ section.id }} .card__price {
      {% if section.settings.xd_cards_color != blank %}color: {{ section.settings.xd_cards_color }};{% endif %}
      {% unless section.settings.xd_cards_align == 'inherit' %}text-align: {{ section.settings.xd_cards_align }};{% endunless %}
    }
  {% endstyle %}
{% endif %}

{% if section.settings.enable_quick_add_button and request.design_mode == false %}
  {% render 'catalog-quick-add-assets' %}
{% endif %}

<cantinflas-product-tabs class="cantinflas-product-tabs{% if section.settings.enable_quick_add_button %} cantinflas-catalog-buy{% endif %}">
  <h2>{{ section.settings.heading | escape }}</h2>
  {% if section.settings.xd_intro != blank %}<div class="cantinflas-tabs-intro rte">{{ section.settings.xd_intro }}</div>{% endif %}
  <div data-tab-list aria-label="{{ section.settings.heading | escape }}" hidden>
    {% for block in section.blocks %}
      <button type="button" id="Tab-{{ section.id }}-{{ block.id }}" aria-controls="Panel-{{ section.id }}-{{ block.id }}">
        {{ block.settings.title | escape }}
      </button>
    {% endfor %}
  </div>
  {% for block in section.blocks %}
    <section id="Panel-{{ section.id }}-{{ block.id }}" data-tab-panel {{ block.shopify_attributes }}>
      <h3>{{ block.settings.title | escape }}</h3>
      <div class="cantinflas-product-tabs__grid">
        {% for product in block.settings.collection.products limit: section.settings.products_to_show %}
          {% liquid
            assign quick_add_product = nil
            assign quick_add_form_id = nil
            if section.settings.enable_quick_add_button
              assign quick_add_product = product
              assign quick_add_form_id = 'TabsForm-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product.id
            endif
          %}
          {% render 'card',
            card_product: product,
            product: quick_add_product,
            img: product.featured_media,
            title: product.title,
            price: product.price,
            url: product.url,
            variants: product.variants,
            product_options: product.options,
            image_ratio: 'square',
            text_alignment: 'left',
            enable_quick_add_button: section.settings.enable_quick_add_button,
            catalog_quick_add: true,
            quick_add_label: 'Comprar',
            product_form_id: quick_add_form_id
          %}
        {% else %}
          {% assign sample_titles = block.settings.sample_titles | newline_to_br | split: '<br />' %}
          {% for sample in (1..section.settings.products_to_show) %}
            {% assign sample_handle = 'product-' | append: sample %}
            <div class="cantinflas-product-tabs__sample">
              {{ sample_handle | placeholder_svg_tag }}
              {% if sample_titles[forloop.index0] != blank %}<p>{{ sample_titles[forloop.index0] | strip | escape }}</p>{% endif %}
            </div>
          {% endfor %}
          {% if request.design_mode %}
            <p>Selecciona una colección con productos para esta pestaña.</p>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</cantinflas-product-tabs>

{% stylesheet %}
  .cantinflas-product-tabs { display: block; width: min(86%, 1640px); margin: clamp(3rem, 5vw, 8rem) auto; }
  .cantinflas-product-tabs h2 { text-align: center; color: #2b3d8f; }
  .cantinflas-product-tabs [data-tab-list]:not([hidden]) { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2rem; margin: 2rem 0; }
  .cantinflas-product-tabs button[role="tab"] { color: inherit; background: transparent; border: 0; padding: .75rem 1rem; cursor: pointer; }
  .cantinflas-product-tabs button[aria-selected="true"] { text-decoration: underline; text-underline-offset: .35em; }
  .cantinflas-product-tabs [role="tabpanel"] > h3 { display: none; }
  .cantinflas-product-tabs__sample svg { display: block; width: 100%; height: auto; background: #f4ede1; }
  .cantinflas-product-tabs__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.2rem; }
  @media (min-width: 900px) {
    .cantinflas-product-tabs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.4rem; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cantinflas-product-tabs')) {
    customElements.define('cantinflas-product-tabs', class extends HTMLElement {
      connectedCallback() {
        const list = this.querySelector('[data-tab-list]');
        const tabs = Array.from(list.querySelectorAll('button'));
        const panels = Array.from(this.querySelectorAll('[data-tab-panel]'));
        if (!tabs.length || list.getAttribute('role') === 'tablist') return;

        const select = (selected) => {
          tabs.forEach((tab, index) => {
            const active = index === selected;
            tab.setAttribute('aria-selected', String(active));
            tab.tabIndex = active ? 0 : -1;
            panels[index].hidden = !active;
          });
        };

        list.setAttribute('role', 'tablist');
        tabs.forEach((tab, index) => {
          tab.setAttribute('role', 'tab');
          panels[index].setAttribute('role', 'tabpanel');
          panels[index].setAttribute('aria-labelledby', tab.id);
          panels[index].tabIndex = 0;
          tab.addEventListener('click', () => select(index));
          tab.addEventListener('keydown', (event) => {
            const destination = {
              ArrowLeft: (index + tabs.length - 1) % tabs.length,
              ArrowRight: (index + 1) % tabs.length,
              Home: 0,
              End: tabs.length - 1
            }[event.key];
            if (destination === undefined) return;
            event.preventDefault();
            select(destination);
            tabs[destination].focus();
          });
        });
        this.addEventListener('shopify:block:select', (event) => {
          const index = panels.indexOf(event.target.closest('[data-tab-panel]'));
          if (index >= 0) select(index);
        });
        select(0);
        list.hidden = false;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Pestañas de productos",
  "settings": [
    {"type": "checkbox", "id": "xd_text_controls", "label": "Usar ajustes de texto del rediseño", "default": false},
    {"type": "color", "id": "xd_heading_color", "label": "Color · Título"},
    {"type": "select", "id": "xd_heading_align", "label": "Alineación · Título", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {"type": "color", "id": "xd_body_color", "label": "Color · Texto"},
    {"type": "select", "id": "xd_body_align", "label": "Alineación · Texto", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {"type": "color", "id": "xd_tabs_color", "label": "Color · Pestañas"},
    {"type": "select", "id": "xd_tabs_align", "label": "Alineación · Pestañas", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {"type": "color", "id": "xd_cards_color", "label": "Color · Tarjetas"},
    {"type": "select", "id": "xd_cards_align", "label": "Alineación · Tarjetas", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {"type": "richtext", "id": "xd_intro", "label": "Subtítulo editorial"},
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "range", "id": "products_to_show", "label": "Productos por pestaña", "min": 2, "max": 8, "step": 1, "default": 4 },
    {
      "type": "checkbox",
      "id": "enable_quick_add_button",
      "default": false,
      "label": "t:sections.featured-collection.settings.enable_quick_add_button.label"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "text", "id": "title", "label": "Etiqueta" },
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "textarea", "id": "sample_titles", "label": "Nombres de muestra, uno por línea" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Pestañas de productos" }]
}
{% endschema %}
