<cantinflas-product-tabs class="cantinflas-product-tabs">
  <h2>{{ section.settings.heading | escape }}</h2>
  <div data-tab-list aria-label="{{ section.settings.heading | escape }}" hidden>
    {% for block in section.blocks %}
      <button type="button" id="Tab-{{ section.id }}-{{ block.id }}" aria-controls="Panel-{{ section.id }}-{{ block.id }}">
        {{ block.settings.title | escape }}
      </button>
    {% endfor %}
  </div>
  {% for block in section.blocks %}
    <section id="Panel-{{ section.id }}-{{ block.id }}" data-tab-panel {{ block.shopify_attributes }}>
      <h3>{{ block.settings.title | escape }}</h3>
      <div class="cantinflas-product-tabs__grid">
        {% for product in block.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'card',
            card_product: product,
            img: product.featured_media,
            title: product.title,
            price: product.price,
            url: product.url,
            variants: product.variants,
            product_options: product.options,
            image_ratio: 'square',
            text_alignment: 'left'
          %}
        {% else %}
          {% if request.design_mode %}
            <p>Selecciona una colección con productos para esta pestaña.</p>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</cantinflas-product-tabs>

{% stylesheet %}
  .cantinflas-product-tabs { display: block; width: min(86%, 1640px); margin: clamp(3rem, 5vw, 8rem) auto; }
  .cantinflas-product-tabs h2 { text-align: center; color: #2b3d8f; }
  .cantinflas-product-tabs [data-tab-list]:not([hidden]) { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2rem; margin: 2rem 0; }
  .cantinflas-product-tabs button[role="tab"] { color: inherit; background: transparent; border: 0; padding: .75rem 1rem; cursor: pointer; }
  .cantinflas-product-tabs button[aria-selected="true"] { text-decoration: underline; text-underline-offset: .35em; }
  .cantinflas-product-tabs [role="tabpanel"] > h3 { display: none; }
  .cantinflas-product-tabs__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.2rem; }
  @media (min-width: 900px) {
    .cantinflas-product-tabs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.4rem; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cantinflas-product-tabs')) {
    customElements.define('cantinflas-product-tabs', class extends HTMLElement {
      connectedCallback() {
        const list = this.querySelector('[data-tab-list]');
        const tabs = Array.from(list.querySelectorAll('button'));
        const panels = Array.from(this.querySelectorAll('[data-tab-panel]'));
        if (!tabs.length || list.getAttribute('role') === 'tablist') return;

        const select = (selected) => {
          tabs.forEach((tab, index) => {
            const active = index === selected;
            tab.setAttribute('aria-selected', String(active));
            tab.tabIndex = active ? 0 : -1;
            panels[index].hidden = !active;
          });
        };

        list.setAttribute('role', 'tablist');
        tabs.forEach((tab, index) => {
          tab.setAttribute('role', 'tab');
          panels[index].setAttribute('role', 'tabpanel');
          panels[index].setAttribute('aria-labelledby', tab.id);
          panels[index].tabIndex = 0;
          tab.addEventListener('click', () => select(index));
          tab.addEventListener('keydown', (event) => {
            const destination = {
              ArrowLeft: (index + tabs.length - 1) % tabs.length,
              ArrowRight: (index + 1) % tabs.length,
              Home: 0,
              End: tabs.length - 1
            }[event.key];
            if (destination === undefined) return;
            event.preventDefault();
            select(destination);
            tabs[destination].focus();
          });
        });
        this.addEventListener('shopify:block:select', (event) => {
          const index = panels.indexOf(event.target.closest('[data-tab-panel]'));
          if (index >= 0) select(index);
        });
        select(0);
        list.hidden = false;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Pestañas de productos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "range", "id": "products_to_show", "label": "Productos por pestaña", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "text", "id": "title", "label": "Etiqueta" },
        { "type": "collection", "id": "collection", "label": "Colección" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Pestañas de productos" }]
}
{% endschema %}
