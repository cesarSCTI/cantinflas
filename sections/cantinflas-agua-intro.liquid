{{ 'cantinflas-agua.css' | asset_url | stylesheet_tag }}
{% liquid
  assign portrait = nil
  assign bottle = nil
  if section.settings.original
    assign portrait = 'portrait'
    assign bottle = 'intro-bottle'
  endif
%}
<cantinflas-agua-intro class="ca-agua ca-intro" style="--ca-background: {{ section.settings.background }};
    --ca-heading: {{ section.settings.heading_color }};
    --ca-text: {{ section.settings.body_color }};
    --ca-heading-align: {{ section.settings.heading_align }};
    --ca-text-align: {{ section.settings.body_align }};
    --ca-heading-size: {{ section.settings.heading_size }}px;
    --ca-body-size: {{ section.settings.body_size }}px;
    --ca-highlight: {{ section.settings.highlight_color }};
    --ca-highlight-align: {{ section.settings.highlight_align }};">
  <div class="ca-intro__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ca-agua__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ca-intro__portrait">
      {% render 'cantinflas-agua-image', image: section.settings.portrait, artwork: portrait, alt: 'Mario Moreno Cantinflas', sizes: '22vw' %}
    </div>
    <div class="ca-intro__copy">
      <div class="ca-agua__body rte">{{ section.settings.body }}</div>
      {% if section.settings.highlight != blank %}
        <p class="ca-intro__highlight">{{ section.settings.highlight | escape }}</p>
      {% endif %}
    </div>
    <div class="ca-intro__bottle">
      {% render 'cantinflas-agua-image', image: section.settings.bottle, artwork: bottle, alt: 'Envase de la edición Museo Cantinflas', sizes: '45vw' %}
    </div>
  </div>
</cantinflas-agua-intro>

{% stylesheet %}
  cantinflas-agua-intro {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ca-intro__portrait {
      --ca-intro-offset: calc(-1 * clamp(28px, 8vw, 140px));
    }

    .ca-intro__bottle {
      --ca-intro-offset: clamp(28px, 8vw, 140px);
    }

    .ca-intro :is(.ca-intro__portrait, .ca-intro__bottle) {
      transition: opacity 550ms ease-out, translate 650ms ease-out;
    }

    .ca-intro[data-intro-pending] :is(.ca-intro__portrait, .ca-intro__bottle) {
      opacity: 0;
      translate: var(--ca-intro-offset) 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cantinflas-agua-intro')) {
    customElements.define('cantinflas-agua-intro', class extends HTMLElement {
      connectedCallback() {
        if (this.revealed || window.Shopify?.designMode || !('IntersectionObserver' in window)) return;

        this.setAttribute('data-intro-pending', '');
        this.observer = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;

          this.revealed = true;
          this.removeAttribute('data-intro-pending');
          this.observer.disconnect();
        }, { rootMargin: '0px 0px -40px 0px' });
        this.observer.observe(this);
      }

      disconnectedCallback() {
        this.observer?.disconnect();
        this.removeAttribute('data-intro-pending');
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Editorial Agua Cantinflas",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¡Mucho más que agua!"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#2b3d8f"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Color del texto",
      "default": "#252525"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del título",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "select",
      "id": "body_align",
      "label": "Alineación del texto",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño máximo del título",
      "default": 80,
      "min": 24,
      "max": 112,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Tamaño máximo del texto",
      "default": 22,
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "original",
      "label": "Usar imágenes originales de XD",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Retrato"
    },
    {
      "type": "image_picker",
      "id": "bottle",
      "label": "Imagen de la edición Museo"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Frase destacada"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Color de la frase",
      "default": "#36845d"
    },
    {
      "type": "select",
      "id": "highlight_align",
      "label": "Alineación de la frase",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Agua Cantinflas"
    }
  ]
}
{% endschema %}
