{% liquid
  assign name_label = 'templates.contact.form.name' | t
  assign phone_label = 'templates.contact.form.phone' | t
  assign email_label = 'templates.contact.form.email' | t
  assign message_label = 'templates.contact.form.comment' | t
  assign submit_label = 'aria-label.contact-form' | t
  if section.settings.xd_contact_layout
    assign name_label = section.settings.xd_name_label | default: name_label
    assign phone_label = section.settings.xd_phone_label | default: phone_label
    assign email_label = section.settings.xd_email_label | default: email_label
    assign message_label = section.settings.xd_message_label | default: message_label
    assign submit_label = section.settings.xd_submit_label | default: submit_label
  endif
%}
{% if section.settings.xd_text_controls %}
  {% style %}
    #shopify-section-{{ section.id }} .cantinflas-contact-layout__details h2, #shopify-section-{{ section.id }} .hero__title {
      {% if section.settings.xd_heading_color != blank %}color: {{ section.settings.xd_heading_color }};{% endif %}
      {% unless section.settings.xd_heading_align == 'inherit' %}text-align: {{ section.settings.xd_heading_align }};{% endunless %}
    }
    #shopify-section-{{ section.id }} .cantinflas-contact-layout__details .rte, #shopify-section-{{ section.id }} .cantinflas-contact-layout__details .rte a {
      {% if section.settings.xd_body_color != blank %}color: {{ section.settings.xd_body_color }};{% endif %}
      {% unless section.settings.xd_body_align == 'inherit' %}text-align: {{ section.settings.xd_body_align }};{% endunless %}
    }
    #shopify-section-{{ section.id }} .form__field__label {
      {% if section.settings.xd_labels_color != blank %}color: {{ section.settings.xd_labels_color }};{% endif %}
      {% unless section.settings.xd_labels_align == 'inherit' %}text-align: {{ section.settings.xd_labels_align }};{% endunless %}
    }
    #shopify-section-{{ section.id }} .wt-newsletter__send__text {
      {% if section.settings.xd_button_color != blank and section.settings.xd_contact_layout == false %}color: {{ section.settings.xd_button_color }};{% endif %}
      {% unless section.settings.xd_button_align == 'inherit' %}text-align: {{ section.settings.xd_button_align }};{% endunless %}
    }
  {% endstyle %}
{% endif %}

{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

<style>
    [data-section-id="{{ section.id }}"]
    {
        {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
          --color-background: {{ section.settings.background_color }};
        {% endif %}

        {% if section.settings.xd_contact_layout %}
          --cc-input: {{ section.settings.xd_contact_field_bg }};
          --cc-card: {{ section.settings.xd_contact_card_bg }};
          --cc-button: {{ section.settings.xd_contact_button_bg }};
          --cc-button-text: {{ section.settings.xd_button_color | default: '#ffffff' }};
          --cc-action-align: {{ section.settings.xd_button_align }};
          --cc-accent: {{ section.settings.xd_contact_accent }};
          --cc-body: {{ section.settings.xd_body_color | default: '#252525' }};
          --cc-label: {{ section.settings.xd_labels_color | default: '#252525' }};
        {% endif %}

        {% if section.settings.margin-top %}
            --section-gap-top: {{ section.settings.margin-top }}px;
        {% endif %}

        {% if section.settings.margin-bottom %}
            --section-gap-bottom: {{ section.settings.margin-bottom }}px;
        {% endif %}

    }

    [data-section-id="{{ section.id }}"] .headline__title,
    [data-section-id="{{ section.id }}"] .hero__text
      {
          {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
            --color-custom-text: {{ section.settings.color-body-text }};
          {% endif %}
      }

    {%- for block in section.blocks -%}
      [data-block-id="{{ block.id }}"]
      {

          --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};

          --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};

      }
  {%- endfor -%}
</style>

<div data-section-id="{{ section.id }}" class="wt-contact__form form__full{% if section.settings.xd_contact_layout %} cantinflas-contact-design{% endif %}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <h2
          data-block-id="{{ block.id }}"
          class="hero__title {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} {% if block.settings.heading_disable_on_mobile == true %} hero__title--mobile{% endif %}"
        >
          {% render 'headline', title: block.settings.heading %}
        </h2>
      {%- when 'paragraph' -%}
        <div class="hero__text form__text{% if block.settings.text_disable_on_mobile == true %} hero__text--mobile{% endif %} rte">
          {{ block.settings.paragraph }}
        </div>
      {%- when 'email_form' -%}
        {% if section.settings.contact_details != blank %}<div class="cantinflas-contact-layout">{% endif %}
        <div class="form__container {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
          <div class="contact-form" {{ block.shopify_attributes }}>
            {%- assign contact_form_id = 'ContactForm-' | append: section.id -%}
            {%- form 'contact', id: contact_form_id, class: 'isolate' -%}
              {%- if form.posted_successfully? -%}
                <div class="form__message">
                  <div class="form__success-field" tabindex="-1" autofocus>
                    <p>{{ 'templates.contact.form.post_success' | t }}</p>
                  </div>
                </div>
              {%- elsif form.errors -%}
                <div class="form__message">
                  <div class="form__error-field">
                    {{ form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email }}
                  </div>
                </div>
              {%- endif -%}
              <div class="form__fieldset">
                <label
                  class="form__field form__field--name"
                  for="ContactFormName-{{ section.id }}"
                >
                  <input
                    type="text"
                    autocomplete="name"
                    {% if section.settings.xd_contact_layout and section.settings.xd_name_required %}required{% endif %}
                    name="contact[name]"
                    id="ContactFormName-{{ section.id }}"
                    class="form__field__input"
                    placeholder=" "
                    value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                  >
                  <span class="form__field__label">{{ name_label | escape }}{% if section.settings.xd_contact_layout and section.settings.xd_name_required %}*{% endif %}</span>
                </label>

                <label
                  class="form__field form__field--phone"
                  for="ContactFormPhone-{{ section.id }}"
                >
                  <input
                    type="tel"
                    autocomplete="tel"
                    name="contact[phone]"
                    id="ContactFormPhone-{{ section.id }}"
                    class="form__field__input"
                    placeholder=" "
                    value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
                  >
                  <span class="form__field__label">{{ phone_label | escape }}</span>
                </label>
              </div>

              <label
                class="form__field form__field--email"
                for="ContactFormEmail-{{ section.id }}"
              >
                <input
                  type="email"
                  autocomplete="email"
                  required
                  name="contact[email]"
                  id="ContactFormEmail-{{ section.id }}"
                  class="form__field__input"
                  placeholder=" "
                  value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                >
                <span class="form__field__label">{{ email_label | escape }}* </span>
              </label>

              <label
                class="form__field"
                for="ContactFormComment-{{ section.id }}"
              >
                <textarea
                  class="form__field__textarea"
                  name="contact[body]"
                  id="ContactFormComment-{{ section.id }}"
                  placeholder=" "
                  rows="6"
                >{{- form.body | escape -}}</textarea>
                <span class="form__field__label">{{ message_label | escape }}</span>
              </label>
              {% if section.settings.xd_contact_layout %}<div class="cantinflas-contact-design__submit">{% endif %}
              <button
                type="submit"
                class="hero__button--primary {% if block.settings.button_select != 'primary' %} hero__button--secondary {% endif %}{% if block.settings.button_select == 'link' %} hero__button--link {% endif %} block__button block{% if block.settings.disable_on_mobile %}__button--mobile{% endif %}"
              >
                <span class="wt-newsletter__send__text">{{ submit_label | escape }}</span>
              </button>
              {% if section.settings.xd_contact_layout %}</div>{% endif %}
            {% endform %}
          </div>
        </div>
        {% if section.settings.contact_details != blank %}
          <aside class="cantinflas-contact-layout__details">
            {% if section.settings.contact_heading != blank %}<h2>{{ section.settings.contact_heading | escape }}</h2>{% endif %}
            <div class="rte">{{ section.settings.contact_details }}</div>
            {% if section.settings.xd_contact_layout and section.settings.xd_contact_social %}
              <div class="cantinflas-contact-design__social">
                {% if section.settings.xd_contact_social_label != blank %}
                  <p>{{ section.settings.xd_contact_social_label | escape }}</p>
                {% endif %}
                {% render 'social-links' %}
              </div>
            {% endif %}
          </aside>
          </div>
        {% endif %}
    {%- endcase -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .cantinflas-contact-layout { display: grid; align-items: start; gap: clamp(2rem, 4vw, 6rem); width: 100%; }
  .cantinflas-contact-layout .form__container { width: 100%; max-width: none; }
  .cantinflas-contact-layout__details { padding: 2.4rem; border: 1px solid rgb(0 0 0 / .12); border-radius: .8rem; }
  .cantinflas-contact-layout__details h2 { margin-top: 0; }
  @media (min-width: 900px) {
    .cantinflas-contact-layout { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  }

  .cantinflas-contact-design {
    padding-block: calc(clamp(76px, 19vw, 132px) + var(--section-gap-top, 0px)) min(7vw, var(--section-gap-bottom, 100px));
    color: var(--cc-body);
  }

  .cantinflas-contact-design > .form__text {
    width: min(86.5%, 1100px);
    max-width: none;
    margin: 0 auto clamp(30px, 6.2vw, 120px);
    padding: 0;
    color: var(--cc-body);
    font-size: clamp(16px, 1.51vw, 29px);
    font-weight: 700;
    line-height: 1.22;
    text-align: center;
  }

  .cantinflas-contact-design > .form__text p { margin: 0; color: inherit; font-size: inherit; line-height: inherit; }

  .cantinflas-contact-design .cantinflas-contact-layout,
  .cantinflas-contact-design > .form__container { width: min(86.5%, 1660px); }

  .cantinflas-contact-design .cantinflas-contact-layout { gap: clamp(30px, 5.8vw, 112px); }
  .cantinflas-contact-design .form__container { max-width: none; padding: 0; }

  .cantinflas-contact-design .form__fieldset { gap: 0 clamp(14px, 1.61vw, 31px); }
  .cantinflas-contact-design .form__field {
    flex-direction: column-reverse;
    gap: .45em;
    margin-block-end: clamp(13px, 1.45vw, 28px);
  }

  .wt-contact__form.cantinflas-contact-design .form__field > .form__field__label {
    position: static;
    display: block;
    height: auto;
    padding-inline: clamp(8px, 1.35vw, 26px);
    transform: none;
    background: transparent;
    color: var(--cc-label);
    font-size: clamp(12px, 1.04vw, 20px);
    line-height: 1.25;
    white-space: normal;
  }

  .cantinflas-contact-design .form__field :is(.form__field__input, .form__field__textarea) {
    box-sizing: border-box;
    min-height: clamp(40px, 3.02vw, 58px);
    border: 1px solid transparent;
    border-radius: clamp(6px, .78vw, 15px);
    background: var(--cc-input);
    padding: .55em clamp(10px, 1.35vw, 26px);
    color: var(--cc-body);
  }

  .cantinflas-contact-design .form__field__textarea { height: clamp(100px, 7.97vw, 153px); resize: vertical; }
  .cantinflas-contact-design :is(input, textarea, button, a):focus-visible {
    outline: 2px solid var(--cc-button);
    outline-offset: 2px;
  }

  .cantinflas-contact-design__submit { text-align: var(--cc-action-align); }

  .cantinflas-contact-design .cantinflas-contact-design__submit button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(126px, 12.03vw, 231px);
    min-height: clamp(40px, 3.18vw, 61px);
    padding: .5em 1.5em;
    border: 1px solid var(--cc-button);
    border-radius: 999px;
    background: var(--cc-button);
    color: var(--cc-button-text);
    font-size: clamp(12px, 1.04vw, 20px);
    letter-spacing: .035em;
  }

  .cantinflas-contact-design .cantinflas-contact-design__submit .hero__button--secondary {
    background: transparent;
    color: var(--cc-button);
  }

  .cantinflas-contact-design .cantinflas-contact-design__submit .hero__button--link {
    border-color: transparent;
    min-width: 0;
    text-decoration: underline;
  }

  .cantinflas-contact-design .cantinflas-contact-layout__details {
    padding: clamp(24px, 3.2vw, 62px) clamp(16px, 2.45vw, 47px);
    background: var(--cc-card);
    border: 0;
    border-radius: clamp(9px, .84vw, 16px);
    box-shadow: 0 2px 16px rgb(0 0 0 / .14);
    color: var(--cc-body);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .cantinflas-contact-design .cantinflas-contact-layout__details h2 {
    margin: 0 0 1em;
    font-size: clamp(24px, 2.03vw, 39px);
    line-height: 1.12;
  }

  .cantinflas-contact-design .cantinflas-contact-layout__details .rte {
    font-size: clamp(14px, 1.35vw, 26px);
  }

  .cantinflas-contact-design .cantinflas-contact-layout__details .rte :is(p, a) {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }

  .cantinflas-contact-design .cantinflas-contact-layout__details .rte p + p { margin-block-start: .85em; }

  .cantinflas-contact-design .cantinflas-contact-layout__details .rte a { text-decoration: none; }
  .cantinflas-contact-design .cantinflas-contact-layout__details .rte a:hover { text-decoration: underline; }
  .cantinflas-contact-design .cantinflas-contact-layout__details a:is([href^="tel:"], [href^="mailto:"])::before {
    display: inline-block;
    width: 1.55em;
    color: var(--cc-accent);
    font-family: Arial, sans-serif;
  }
  .cantinflas-contact-design .cantinflas-contact-layout__details a[href^="tel:"]::before { content: '\260e' / ''; }
  .cantinflas-contact-design .cantinflas-contact-layout__details a[href^="mailto:"]::before { content: '\2709' / ''; }

  .cantinflas-contact-design__social { margin-block-start: 1em; font-size: clamp(14px, 1.35vw, 26px); }
  .cantinflas-contact-design__social p { margin: 0 0 .35em; }
  .cantinflas-contact-design__social .social-links {
    justify-content: center;
    gap: .55em;
    margin: 0;
    padding: 0;
  }

  .cantinflas-contact-design__social .social-link {
    display: grid;
    place-items: center;
    width: clamp(30px, 2.18vw, 42px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cc-accent);
    color: var(--cc-card);
  }

  .cantinflas-contact-design__social .social-link svg { width: 58%; height: 58%; }

  @media (max-width: 899px) {
    .cantinflas-contact-design .cantinflas-contact-layout__details { max-width: 470px; width: 100%; justify-self: center; }
    .cantinflas-contact-design .cantinflas-contact-design__submit button { min-height: 44px; }
    .cantinflas-contact-design__social .social-link { width: 36px; }
  }

  @media (min-width: 750px) {
    .cantinflas-contact-design { padding-block-start: calc(clamp(105px, 14.6vw, 280px) + var(--section-gap-top, 0px)); }
  }

  @media (min-width: 900px) {
    .cantinflas-contact-design .cantinflas-contact-layout { grid-template-columns: minmax(0, 1081fr) minmax(0, 459fr); }
    .cantinflas-contact-design .cantinflas-contact-layout__details { min-height: clamp(225px, 23.75vw, 456px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {"type": "checkbox", "id": "xd_contact_layout", "label": "Composición del diseño de Contacto", "default": false},
    {"type": "text", "id": "xd_name_label", "label": "Etiqueta de nombre", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "checkbox", "id": "xd_name_required", "label": "Pedir nombre obligatorio", "default": false, "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "text", "id": "xd_phone_label", "label": "Etiqueta de teléfono", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "text", "id": "xd_email_label", "label": "Etiqueta de correo electrónico", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "text", "id": "xd_message_label", "label": "Etiqueta del mensaje", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "text", "id": "xd_submit_label", "label": "Texto del botón de envío", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "color", "id": "xd_contact_field_bg", "label": "Fondo de los campos", "default": "#f5f5f5", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "color", "id": "xd_contact_button_bg", "label": "Fondo del botón de envío", "default": "#ca3732", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "color", "id": "xd_contact_card_bg", "label": "Fondo de la tarjeta", "default": "#ffffff", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "color", "id": "xd_contact_accent", "label": "Color de iconos de contacto y redes", "default": "#f2b846", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "checkbox", "id": "xd_contact_social", "label": "Mostrar redes en la tarjeta", "default": false, "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "text", "id": "xd_contact_social_label", "label": "Etiqueta de redes", "default": "Redes Sociales", "visible_if": "{{ section.settings.xd_contact_layout }}"},
    {"type": "checkbox", "id": "xd_text_controls", "label": "Usar ajustes de texto del rediseño", "default": false},
    {"type": "color", "id": "xd_heading_color", "label": "Color · Título"},
    {"type": "select", "id": "xd_heading_align", "label": "Alineación · Título", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {"type": "color", "id": "xd_body_color", "label": "Color · Texto"},
    {"type": "select", "id": "xd_body_align", "label": "Alineación · Texto", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {"type": "color", "id": "xd_labels_color", "label": "Color · Etiquetas"},
    {"type": "select", "id": "xd_labels_align", "label": "Alineación · Etiquetas", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {"type": "color", "id": "xd_button_color", "label": "Color · Botón"},
    {"type": "select", "id": "xd_button_align", "label": "Alineación · Botón", "default": "inherit", "options": [{"value": "inherit", "label": "Tema"}, {"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}, {"value": "right", "label": "Derecha"}]},
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Título de la tarjeta de contacto"
    },
    {
      "type": "richtext",
      "id": "contact_details",
      "label": "Datos de contacto"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "default": "transparent",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "transparent",
      "label": "t:sections.settings.settings.background-color.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 20,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 20,
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.newsletter.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "heading",
          "default": "Contact form",
          "label": "t:sections.settings.settings.heading.label"
        },
        {
          "type": "checkbox",
          "id": "heading_disable_on_mobile",
          "label": "t:sections.global.disable_on_mobile",
          "default": false
        },
        {
          "type": "range",
          "id": "size_heading",
          "min": 50,
          "max": 500,
          "step": 10,
          "default": 100,
          "label": "t:sections.settings.settings.size-heading.label",
          "unit": "%"
        },
        {
          "type": "range",
          "id": "size_heading_mobile",
          "min": 80,
          "max": 300,
          "step": 10,
          "default": 100,
          "label": "t:sections.settings.settings.size-heading-mobile.label",
          "unit": "%"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "paragraph",
          "default": "<p>Be the first to know about new collections and exclusive offers.</p>",
          "label": "t:sections.settings.settings.text.label"
        },
        {
          "type": "checkbox",
          "id": "text_disable_on_mobile",
          "label": "t:sections.global.disable_on_mobile",
          "default": false
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "button_select",
          "options": [
            {
              "value": "primary",
