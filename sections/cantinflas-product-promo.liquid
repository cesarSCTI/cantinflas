{%- liquid
  assign promo_product = section.settings.product
  assign variant = promo_product.selected_or_first_available_variant
  if variant.available == false
    assign variant = promo_product.first_available_variant
  endif
  assign product_image = section.settings.product_image | default: promo_product.featured_image
  assign product_title = section.settings.product_title | default: promo_product.title
  assign details_url = section.settings.discover_link | default: promo_product.url
  assign product_form_id = 'CantinflasPromo-' | append: section.id
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    --promo-background: {{ section.settings.background }};
    --promo-buy: {{ section.settings.buy_color }};
    --promo-discover: {{ section.settings.discover_color }};
    --promo-buy-text: {{ section.settings.buy_text | default: section.settings.button_text }};
    --promo-discover-text: {{ section.settings.discover_text | default: section.settings.button_text }};
    --promo-accent: {{ section.settings.accent_color }};
    --promo-actions-align: {{ section.settings.button_align }};
    {% assign roles = 'title,kicker,intro,product_title,tagline,description' | split: ',' %}
    {% for role in roles %}
      {% assign color = role | append: '_color' %}
      {% assign alignment = role | append: '_align' %}
      {% assign desktop = role | append: '_size' %}
      {% assign mobile = role | append: '_mobile' %}
      --promo-{{ role }}-color: {{ section.settings[color] }};
      --promo-{{ role }}-align: {{ section.settings[alignment] }};
      --promo-{{ role }}-desktop: {{ section.settings[desktop] }}px;
      --promo-{{ role }}-mobile: {{ section.settings[mobile] }}px;
    {% endfor %}
  }
{% endstyle %}
<section class="cantinflas-promo">
  <header class="cantinflas-promo__intro">
    <h2 class="cantinflas-promo__text cantinflas-promo__title">{{ section.settings.title | escape }}{% if section.settings.accent != blank %} <span>{{ section.settings.accent | escape }}</span>{% endif %}</h2>
    {% if section.settings.kicker != blank %}<p class="cantinflas-promo__text cantinflas-promo__kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
    {% if section.settings.intro != blank %}<div class="cantinflas-promo__text cantinflas-promo__intro-text rte">{{ section.settings.intro }}</div>{% endif %}
  </header>
  <div class="cantinflas-promo__grid">
    <div class="cantinflas-promo__product">
      <div class="cantinflas-promo__product-image">
        {% if product_image != blank %}
          {{ product_image | image_url: width: 960 | image_tag: loading: 'lazy', widths: '320, 480, 640, 960', sizes: '(min-width: 900px) 32vw, 85vw' }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'cantinflas-promo__placeholder' }}
        {% endif %}
      </div>
      {% if product_title != blank %}<h3 class="cantinflas-promo__text cantinflas-promo__product-title">{{ product_title | escape }}</h3>{% endif %}
      {% if section.settings.tagline != blank %}<p class="cantinflas-promo__text cantinflas-promo__tagline">{{ section.settings.tagline | escape }}</p>{% endif %}
      {% if section.settings.description != blank %}<div class="cantinflas-promo__text cantinflas-promo__description rte">{{ section.settings.description }}</div>{% endif %}
      {% if promo_product != blank and promo_product.available and promo_product.requires_selling_plan == false and section.settings.buy_label != blank %}
        {% form 'product', promo_product, id: product_form_id, return_to: '/checkout' %}
          {% if promo_product.has_only_default_variant %}
            <input type="hidden" name="id" value="{{ variant.id }}">
          {% else %}
            <label class="cantinflas-promo__variant" for="PromoVariant-{{ section.id }}">
              {{ section.settings.variant_label | escape }}
              <select id="PromoVariant-{{ section.id }}" name="id" required>
                {% for option_variant in promo_product.variants %}
                  <option value="{{ option_variant.id }}"{% if option_variant.id == variant.id %} selected{% endif %}{% unless option_variant.available %} disabled{% endunless %}>{{ option_variant.title | escape }}</option>
                {% endfor %}
              </select>
            </label>
          {% endif %}
          <div class="cantinflas-promo__actions">
            <button type="submit" class="cantinflas-promo__buy">{{ section.settings.buy_label | escape }}</button>
            {% if details_url != blank and section.settings.discover_label != blank %}<a class="cantinflas-promo__discover" href="{{ details_url }}">{{ section.settings.discover_label | escape }}</a>{% endif %}
          </div>
        {% endform %}
      {% else %}
        <div class="cantinflas-promo__actions">
          {% if section.settings.buy_label != blank %}<button type="button" class="cantinflas-promo__buy" disabled>{{ section.settings.buy_label | escape }}</button>{% endif %}
          {% if details_url != blank and section.settings.discover_label != blank %}
            <a class="cantinflas-promo__discover" href="{{ details_url }}">{{ section.settings.discover_label | escape }}</a>
          {% elsif section.settings.discover_label != blank %}
            <button type="button" class="cantinflas-promo__discover" disabled>{{ section.settings.discover_label | escape }}</button>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="cantinflas-promo__media">
      {% if section.settings.video != blank %}
        {%- assign poster = section.settings.media_image | default: section.settings.video.preview_image -%}
        {%- assign poster_url = poster | image_url: width: 1200 -%}
        {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', poster: poster_url }}
      {% elsif section.settings.media_image != blank %}
        {{ section.settings.media_image | image_url: width: 1440 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1440', sizes: '(min-width: 900px) 50vw, 100vw' }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'cantinflas-promo__placeholder' }}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cantinflas-promo { background: var(--promo-background); padding: clamp(2.4rem, 3.5vw, 6.8rem) 0; }
  .cantinflas-promo__intro { width: min(90%, 150rem); margin: 0 auto clamp(2.4rem, 4.1vw, 8rem); }
  .cantinflas-promo__text { margin: 0; font-size: var(--promo-mobile); line-height: 1.22; text-align: var(--promo-align); color: var(--promo-color); }
  .cantinflas-promo__title { --promo-color: var(--promo-title-color); --promo-align: var(--promo-title-align); --promo-mobile: var(--promo-title-mobile); --promo-desktop: var(--promo-title-desktop); line-height: 1.05; }
  .cantinflas-promo__title span { color: var(--promo-accent); }
  .cantinflas-promo__kicker { --promo-color: var(--promo-kicker-color); --promo-align: var(--promo-kicker-align); --promo-mobile: var(--promo-kicker-mobile); --promo-desktop: var(--promo-kicker-desktop); font-family: var(--font-headline); font-weight: 700; margin-top: clamp(1.2rem, 2.7vw, 5.2rem); }
  .cantinflas-promo__intro-text { --promo-color: var(--promo-intro-color); --promo-align: var(--promo-intro-align); --promo-mobile: var(--promo-intro-mobile); --promo-desktop: var(--promo-intro-desktop); margin-top: 1.5rem; }
  .cantinflas-promo__product-title { --promo-color: var(--promo-product_title-color); --promo-align: var(--promo-product_title-align); --promo-mobile: var(--promo-product_title-mobile); --promo-desktop: var(--promo-product_title-desktop); margin-top: 1.6rem; }
  .cantinflas-promo__tagline { --promo-color: var(--promo-tagline-color); --promo-align: var(--promo-tagline-align); --promo-mobile: var(--promo-tagline-mobile); --promo-desktop: var(--promo-tagline-desktop); font-style: italic; font-weight: 700; margin-top: 1.1rem; }
  .cantinflas-promo__description { --promo-color: var(--promo-description-color); --promo-align: var(--promo-description-align); --promo-mobile: var(--promo-description-mobile); --promo-desktop: var(--promo-description-desktop); margin-top: .7rem; }
  .cantinflas-promo__text.rte p { margin: 0; font-size: inherit; color: inherit; }
  .cantinflas-promo__grid { display: grid; gap: 2rem; }
  .cantinflas-promo__product { width: min(86%, 70rem); margin: auto; }
  .cantinflas-promo__product-image { height: clamp(17rem, 32vw, 63rem); }
  .cantinflas-promo__product-image :is(img, svg) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .cantinflas-promo__media { aspect-ratio: 900 / 1000; background: #f4ede1; overflow: hidden; }
  .cantinflas-promo__media :is(img, video, svg) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .cantinflas-promo__variant { display: block; text-align: var(--promo-actions-align); margin-top: 1rem; }
  .cantinflas-promo__variant select { max-width: 100%; font: inherit; }
  .cantinflas-promo__actions { text-align: var(--promo-actions-align); margin-top: clamp(1rem, 1.8vw, 3.4rem); }
  .cantinflas-promo__actions :is(button, a) { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: min(100%, 16rem); margin: .3rem; border: 0; border-radius: 999px; padding: .7rem 1.2rem; font: inherit; font-weight: 600; text-decoration: none; }
  .cantinflas-promo__actions button:disabled { cursor: default; }
  .cantinflas-promo__buy { background: var(--promo-buy); color: var(--promo-buy-text); }
  .cantinflas-promo__discover { background: var(--promo-discover); color: var(--promo-discover-text); }
  @media (min-width: 900px) {
    .cantinflas-promo__grid { grid-template-columns: minmax(0, 49fr) minmax(0, 51fr); gap: 0; }
    .cantinflas-promo__text { font-size: min(var(--promo-desktop), calc(var(--promo-desktop) * .65 + 2.7vw)); }
  }
{% endstylesheet %}

