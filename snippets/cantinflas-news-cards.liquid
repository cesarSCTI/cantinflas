{%- liquid
  assign news_blog = section.settings.blog
  assign article_count = news_blog.articles.size | default: 0 | at_most: section.settings.post_limit
  assign card_count = article_count
  if article_count == 0
    assign card_count = section.settings.post_limit
  endif

  assign media_ratio = '551 / 314'
  if section.settings.image_ratio == 'square'
    assign media_ratio = '1'
  elsif section.settings.image_ratio == 'portrait'
    assign media_ratio = '2 / 3'
  endif
-%}
<div class="cantinflas-news{% if section.settings['full-width-enabled'] %} cantinflas-news--wide{% endif %}{% unless section.settings.show_image %} cantinflas-news--text-only{% endunless %}"
  style="
    --cn-header: {{ section.settings.background_color }};
    --cn-surface: {{ section.settings.xd_news_surface }};
    --cn-title: {{ section.settings.xd_title_color | default: '#ffffff' }};
    --cn-intro: {{ section.settings.xd_intro_color | default: '#ffffff' }};
    --cn-card: {{ section.settings['color-body-text'] }};
    --cn-date: {{ section.settings.xd_news_date_color }};
    --cn-action: {{ section.settings.xd_news_button_color }};
    --cn-action-text: {{ section.settings.xd_news_button_text }};
    --cn-title-align: {{ section.settings.xd_news_heading_align }};
    --cn-intro-align: {{ section.settings.xd_intro_align }};
    --cn-card-align: {{ section.settings.column_alignment }};
    --cn-heading-scale: {{ section.settings.size_heading | divided_by: 100.0 }};
    --cn-mobile-scale: {{ section.settings.size_heading_mobile | divided_by: 100.0 }};
    --cn-media-ratio: {{ media_ratio }};
    --cn-columns: {{ section.settings.post_limit }};
    --cn-padding-top: {{ section.settings.margin-top }}px;
    --cn-padding-bottom: {{ section.settings.margin-bottom }}px;
  "
>
  <header class="cantinflas-news__header">
    <div class="cantinflas-news__container">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% endif %}
      {% if section.settings.xd_intro != blank %}
        <div class="cantinflas-news__intro rte">{{ section.settings.xd_intro }}</div>
      {% endif %}
    </div>
  </header>

  <div class="cantinflas-news__content cantinflas-news__container">
    <ul class="cantinflas-news__cards{% if section.settings.swipe_on_mobile %} cantinflas-news__cards--swipe{% endif %}" role="list"{% if section.settings.swipe_on_mobile %} tabindex="0"{% endif %}>
      {% for card_number in (1..card_count) %}
        {% liquid
          if card_number <= article_count
            assign post = news_blog.articles[forloop.index0]
            assign card_title = post.title
            assign card_image = post.image
            assign card_url = post.url
            assign card_date = post.published_at | date: '%d | %m | %Y'
          else
            assign post = nil
            assign card_title = section.settings.xd_sample_title
            assign card_image = section.settings.xd_sample_image
            assign card_url = section.settings.xd_news_sample_link
            assign card_date = section.settings.xd_news_sample_date
          endif
          assign card_alt = card_image.alt | default: card_title
        %}
        <li class="cantinflas-news__card">
          <article>
            {% if section.settings.show_image %}
              {% if card_url != blank %}
                <a class="cantinflas-news__media" href="{{ card_url | escape }}" aria-label="{{ card_title | escape }}">
              {% else %}
                <div class="cantinflas-news__media">
              {% endif %}
              {% if card_image != blank %}
                {{ card_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900, 1100', sizes: '(min-width: 750px) 33vw, 90vw', alt: card_alt }}
              {% elsif post == blank and section.settings.xd_news_sample_art %}
                <img src="{{ 'cantinflas-xd-inauguracion.webp' | asset_url }}" alt="Corte de listón en el Museo Mario Moreno Cantinflas" width="547" height="365" loading="lazy">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'cantinflas-news__placeholder' }}
              {% endif %}
              {% if card_url != blank %}</a>{% else %}</div>{% endif %}
            {% endif %}
            <div class="cantinflas-news__card-copy">
              {% if section.settings.show_date and card_date != blank %}
                {% if post != blank %}
                  <time datetime="{{ post.published_at | date: '%Y-%m-%d' }}">{{ card_date }}</time>
                {% else %}
                  <span class="cantinflas-news__date">{{ card_date | escape }}</span>
                {% endif %}
              {% endif %}
              {% if section.settings.show_author and post.author != blank %}
                <span class="cantinflas-news__author">{{ post.author | escape }}</span>
              {% endif %}
              {% if card_title != blank %}
                <h3>
                  {% if card_url != blank %}<a href="{{ card_url | escape }}">{{ card_title | escape }}</a>{% else %}{{ card_title | escape }}{% endif %}
                </h3>
              {% endif %}
              {% if section.settings.xd_news_button_label != blank %}
                {% if card_url != blank %}
                  <a class="cantinflas-news__button cantinflas-news__button--{{ section.settings.button_select }}" href="{{ card_url | escape }}" aria-label="{{ section.settings.xd_news_button_label | escape }}: {{ card_title | escape }}">{{ section.settings.xd_news_button_label | escape }}</a>
                {% else %}
                  <span class="cantinflas-news__button cantinflas-news__button--{{ section.settings.button_select }}">{{ section.settings.xd_news_button_label | escape }}</span>
                {% endif %}
              {% endif %}
            </div>
          </article>
        </li>
      {% endfor %}
    </ul>
    {% if section.settings.show_view_all and news_blog.articles_count > section.settings.post_limit %}
      <div class="cantinflas-news__view-all">
        <a class="cantinflas-news__button cantinflas-news__button--{{ section.settings.view_all_button_select }}" href="{{ news_blog.url | escape }}">{{ 'sections.featured_blog.view_all' | t }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .cantinflas-news {
    --cn-width: min(90%, 1640px);
    --cn-overlap: clamp(46px, 8.2vw, 145px);
    background: var(--cn-surface);
  }

  .cantinflas-news--wide { --cn-width: 96%; }
  .cantinflas-news--text-only { --cn-overlap: 0px; }

  .cantinflas-news__container {
    width: var(--cn-width);
    margin-inline: auto;
  }

  .cantinflas-news__header {
    padding-block: calc(clamp(22px, 4.2vw, 85px) + var(--cn-padding-top)) calc(clamp(30px, 6.7vw, 110px) + var(--cn-overlap));
    background: var(--cn-header);
  }

  .cantinflas-news .cantinflas-news__header h2 {
    margin: 0;
    color: var(--cn-title);
    font-size: calc(clamp(29px, 5.5vw, 44px) * var(--cn-mobile-scale));
    line-height: 1.04;
    text-align: var(--cn-title-align);
    overflow-wrap: anywhere;
  }

  .cantinflas-news__intro {
    margin-block-start: clamp(10px, 1.6vw, 25px);
    color: var(--cn-intro);
    font-size: clamp(13px, 1.24vw, 17px);
    line-height: 1.45;
    text-align: var(--cn-intro-align);
  }

  .cantinflas-news__intro :is(p, li) { color: inherit; font-size: inherit; line-height: inherit; }
  .cantinflas-news__intro > :first-child { margin-block-start: 0; }
  .cantinflas-news__intro > :last-child { margin-block-end: 0; }

  .cantinflas-news__content {
    position: relative;
    margin-block-start: calc(-1 * var(--cn-overlap));
    padding-block-end: calc(clamp(16px, 3vw, 48px) + var(--cn-padding-bottom));
  }

  .cantinflas-news__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 1.8vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cantinflas-news--text-only .cantinflas-news__cards { padding-block-start: 20px; }
  .cantinflas-news__card { min-width: 0; }
  .cantinflas-news__card article { height: 100%; }

  .cantinflas-news__media {
    display: block;
    aspect-ratio: var(--cn-media-ratio);
    overflow: hidden;
    border-radius: clamp(8px, 1.04vw, 20px);
    background: #f4ede1;
  }

  .cantinflas-news__media :is(img, svg) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .cantinflas-news__card-copy {
    margin-block-start: clamp(10px, 1.25vw, 18px);
    color: var(--cn-card);
    text-align: var(--cn-card-align);
    overflow-wrap: anywhere;
  }

  .cantinflas-news__card-copy :is(time, .cantinflas-news__date, .cantinflas-news__author) {
    color: var(--cn-date);
    font-size: clamp(11px, 1vw, 14px);
    line-height: 1.25;
  }

  .cantinflas-news .cantinflas-news__card-copy h3 {
    margin: .42em 0 0;
    color: inherit;
    font-size: clamp(16px, 1.5625vw, 30px);
    line-height: 1.18;
  }

  .cantinflas-news__card-copy h3 a { color: inherit; text-decoration: none; }
  .cantinflas-news__card-copy h3 a:hover { text-decoration: underline; }

  .cantinflas-news .cantinflas-news__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(92px, 9.3229vw, 179px);
    min-height: clamp(32px, 2.61vw, 50px);
    margin-block-start: clamp(12px, 1.8vw, 24px);
    border: 1px solid var(--cn-action);
    border-radius: 999px;
    padding: 4px clamp(18px, 2.2vw, 32px);
    background: var(--cn-action);
    color: var(--cn-action-text);
    font-size: clamp(12px, 1.08vw, 15px);
    font-weight: 700;
    line-height: 1.15;
    text-decoration: none;
  }

  .cantinflas-news a.cantinflas-news__button:hover,
  .cantinflas-news .cantinflas-news__button--secondary { background: var(--cn-surface); color: var(--cn-action); }

  .cantinflas-news .cantinflas-news__button--link {
    min-width: 0;
    padding-inline: 0;
    border-color: transparent;
    background: transparent;
    color: var(--cn-action);
    text-decoration: underline;
  }

  .cantinflas-news__view-all { text-align: center; }

  .cantinflas-news :is(a, ul):focus-visible { outline: 2px solid var(--cn-action); outline-offset: 3px; }

  @media (min-width: 750px) {
    .cantinflas-news .cantinflas-news__header h2 { font-size: calc(clamp(34px, 4.17vw, 80px) * var(--cn-heading-scale)); }
    .cantinflas-news__cards { grid-template-columns: repeat(var(--cn-columns), minmax(0, 1fr)); }
  }

  @media (max-width: 749px) {
    .cantinflas-news__cards--swipe {
      grid-template-columns: none;
      grid-auto-columns: 86%;
      grid-auto-flow: column;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .cantinflas-news__cards--swipe > li { scroll-snap-align: start; }
    .cantinflas-news .cantinflas-news__button { min-height: 44px; }
  }
{% endstylesheet %}
